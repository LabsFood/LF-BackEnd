# Copiez ce fichier en `.env` a la racine du dossier parent (a cote du
# docker-compose.yml copie), pas dans ce dossier local-dev/.
# Voir LF-BackEnd/LOCAL_SETUP.md.
#
# Toutes les valeurs sont optionnelles pour un premier lancement : le backend
# tourne en "mode stub" sans elles (voir LF-BackEnd/AGENTS.md). Ne remplissez
# que ce dont vous avez besoin pour tester une integration precise.

# Clerk (auth) — laisser sk_test_placeholder pour un dev local sans vraie auth
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe (paiement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cronofy (agenda / disponibilites chef)
CRONOFY_CLIENT_ID=
CRONOFY_CLIENT_SECRET=
CRONOFY_DATA_CENTER=us

# Stream (messagerie temps reel)
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_APP_ID=

# Brevo — email transactionnel backend
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@labsfood.com
BREVO_SENDER_NAME=Labs Food

# Google Maps
GOOGLE_MAPS_API_KEY=

# AWS S3 (documents / medias)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=

# labsfood-web — Brevo SMTP (formulaires contact / candidature chef)
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=
CONTACT_TO_EMAIL=
