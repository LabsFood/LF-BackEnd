{"nodes": [{"id": "docs_deploy_railway_deployment", "label": "Railway deployment of LF-BackEnd", "file_type": "document", "source_file": "docs/deploy/railway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twelve-factor config in the Railway dashboard; Docker build from apps/Dockerfile per railway.toml, health check GET /health. The Compose postgres service is deliberately not deployed; Supabase is the database."}, {"id": "docs_deploy_railway_entrypoint_migrate", "label": "Container entrypoint runs migrate deploy", "file_type": "concept", "source_file": "docs/deploy/railway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/scripts/docker-entrypoint.sh runs prisma migrate deploy once per deploy using SUPABASE_DB_MIGRATION_URL before node dist/main.js, so schema and code ship together."}, {"id": "docs_deploy_railway_public_vs_private_networking", "label": "Public domain vs railway.internal", "file_type": "rationale", "source_file": "docs/deploy/railway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "*.railway.internal is reachable only by other Railway services in the project; browsers, webhooks and curl need the generated public domain. Empty Swagger or /ready responses usually mean the internal hostname was used."}, {"id": "docs_deploy_railway_health_ready", "label": "GET /health vs GET /ready", "file_type": "concept", "source_file": "docs/deploy/railway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/health is liveness with no database and is what Railway probes; /ready pings Postgres through the runtime pooler URL and is for post-deploy smoke tests."}, {"id": "docs_deploy_railway_port_injection", "label": "Railway PORT injection", "file_type": "concept", "source_file": 