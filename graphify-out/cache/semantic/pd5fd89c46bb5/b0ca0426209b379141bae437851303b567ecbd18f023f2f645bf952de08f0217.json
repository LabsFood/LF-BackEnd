{"nodes": [{"id": "_claude_prds_brevo_templates_prd", "label": "PRD: Brevo email templates (HTML sources, safety tests, editing workflow)", "file_type": "document", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_brevo_templates_prd_html_template_sources", "label": "One .html per BREVO_TPL_* plus layout.html, loaded by templates.mjs", "file_type": "concept", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native .html import fails with ERR_UNKNOWN_FILE_EXTENSION on Node 20 and 26, so readFileSync with import.meta.url; file name equals env var so no mapping table; output must stay byte-identical to the previous JS literals."}, {"id": "_claude_prds_brevo_templates_prd_security_rules", "label": "Six node:test template security rules", "file_type": "rationale", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attacker-typed text from the public candidature form reaches admin inboxes; rules: params within the declared list, no |safe or autoescape off or raw, href only from *Url params or https/mailto, user-controlled vars never inside attributes, sign-in templates contain signInUrl, build takes no runtime data."}, {"id": "_claude_prds_brevo_templates_prd_upload_check_update", "label": "upload.mjs --check / --update / --force (repo as source of truth)", "file_type": "rationale", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old upload skipped templates by name, so edits silently never reached Brevo; --check is a read-only drift report, --update pushes subject and htmlContent only and refuses to overwrite a Brevo-side edit without --force."}, {"id": "_claude_prds_brevo_templates_prd_no_template_engine", "label": "No template engine (EJS, Handlebars, Pug rejected)", "file_type": "rationale", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brevo already renders params at send time, so a Node engine would only assemble static HTML at build time with a second language and second escaping model; Handlebars collides with Brevo's {{ }}; adds a dependency."}, {"id": "_claude_prds_brevo_templates_prd_pongo2", "label": "Brevo Pongo2 template language (auto-escaped variables)", "file_type": "concept", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_brevo_templates_prd_upload_digest", "label": "Upload digest comment (sha256 of subject and whitespace-collapsed HTML)", "file_type": "rationale", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lives in each Brevo account (staging and prod keep their own), no lock file to commit, stripped at send; a template tag was rejected because it would split send statistics per version."}, {"id": "_claude_prds_brevo_templates_prd_email_wiring_defects", "label": "Email wiring defects found by live Brevo cross-check", "file_type": "concept", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sender noreply@labsfood.com not owned (must be contact@labsfood.fr); PUBLIC_SITE_URL points to the corporate site; signInUrl lands on Clerk's Account Portal; admin link on the wrong host; candidate name fields need DTO limits."}, {"id": "_claude_prds_brevo_templates_prd_postmark_cli", "label": "postmark-cli templates push/pull (repo-as-source model)", "file_type": "concept", "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_prds_brevo_templates_prd", "target": "_claude_prds_brevo_templates_prd_html_template_sources", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_brevo_templates_prd", "target": "_claude_prds_brevo_templates_prd_security_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_brevo_templates_prd", "target": "_claude_prds_brevo_templates_prd_upload_check_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_brevo_templates_prd", "target": "_claude_prds_brevo_templates_prd_no_template_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_brevo_templates_prd", "target": "_claude_prds_brevo_templates_prd_pongo2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_brevo_templates_prd", "target": "_claude_prds_brevo_templates_prd_upload_digest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/brevo-templates.prd.md", "source_location": null, "weight": 1.0}, {"s