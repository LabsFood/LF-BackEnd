{"nodes": [{"id": "docs_evolution_platform_spec_alignment_evolution_resolved_decisions", "label": "Resolved platform decisions (no re-litigation without ADR)", "file_type": "rationale", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORM Prisma over TypeORM, Clerk over spec email/password JWT, bookings over spec reservation naming, chef over provider, Cronofy for calendar, Stream for messaging. Recorded so the spec's illustrative choices are not re-argued per epic."}, {"id": "docs_evolution_platform_spec_alignment_evolution_e0_prisma", "label": "E0 \u2014 Prisma adoption", "file_type": "concept", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baseline 20250522120000_init reproduces the former TypeORM DDL, so existing databases can be marked applied rather than rebuilt."}, {"id": "docs_evolution_platform_spec_alignment_evolution_e1_provider_to_chef", "label": "E1 \u2014 provider to chef rename", "file_type": "concept", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enum and table renamed, but provider_id columns and a chefId API alias were intentionally kept so the existing booking flow does not break while terminology aligns."}, {"id": "docs_evolution_platform_spec_alignment_evolution_e2_bookings", "label": "E2 \u2014 Bookings lifecycle", "file_type": "concept", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /bookings replaced its 501 scaffold, which is breaking for callers that asserted 501. Lifecycle states shopping/cooking/delivered and the booking_meals junction remain Todo."}, {"id": "docs_evolution_platform_spec_alignment_evolution_e8_payments", "label": "E8 \u2014 Payments epic", "file_type": "concept", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delivered in two waves: card/Connect/commissions on 2026-08-31, prefinanced CESU and the SEPA commission-debit engine on 2026-09-05."}, {"id": "docs_evolution_platform_spec_alignment_evolution_admin_pagination_breaking", "label": "Admin list pagination breaking change", "file_type": "rationale", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /admin/clients now returns { data, meta } instead of a bare array; shared primitives live in apps/src/common/dto/pagination.dto.ts for the other admin lists."}, {"id": "docs_evolution_platform_spec_alignment_evolution_auth_register_reversal", "label": "Reversal of the auth/register out-of-scope decision", "file_type": "rationale", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorded 2026-08-03: the product needs self-serve sign-up before booking, so the API owns registration while Clerk keeps sign-in. Sign-in, refresh and logout stay off the API."}, {"id": "docs_evolution_platform_spec_alignment_evolution_unvetted_chef_money_gap", "label": "Unvetted chef is payable (money-bearing gap)", "file_type": "rationale", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "is_active and is_verified are still read nowhere, so a self-registered chef who completes Stripe Connect onboarding can be paid. Chef listings, booking assignment and any future ChefGuard must filter on both."}, {"id": "docs_evolution_platform_spec_alignment_evolution_module_traceability", "label": "Spec module to NestJS module traceability", "file_type": "concept", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps SPEC-BACKEND section 2.2 modules onto delivered NestJS modules; payments and content-cms are the only ones marked Done."}, {"id": "docs_evolution_platform_spec_alignment_evolution_out_of_scope_auth_routes", "label": "Auth routes intentionally out of scope", "file_type": "rationale", "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /auth/login, /refresh and /logout stay off the API because Clerk owns sign-in and session lifecycle on the Next.js frontend."}], "edges": [{"source": "docs_evolution_platform_spec_alignment_evolution_resolved_decisions", "target": "docs_evolution_platform_spec_alignment_evolution_e0_prisma", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "weight": 1.0}, {"source": "docs_evolution_platform_spec_alignment_evolution_resolved_decisions", "target": "docs_evolution_platform_spec_alignment_evolution_e1_provider_to_chef", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evolution/platform-spec-alignment-evolution.md", "source_location": null, "weight": 1.0}, {"source": "docs_evolution_platform_spec_alignment_evolution_e0_prisma", "target": "docs_database_connection_prisma_baseline", "relation": "references", "confidence": "EXTRACTED", "confidence_s