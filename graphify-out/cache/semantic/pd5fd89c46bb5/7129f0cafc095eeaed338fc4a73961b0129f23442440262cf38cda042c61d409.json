{"nodes": [{"id": "brevo_readme", "label": "Brevo email templates README", "file_type": "document", "source_file": "brevo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repo is the source of truth for transactional email text; Brevo holds a copy kept in sync by upload.mjs."}, {"id": "brevo_readme_template_security_rules", "label": "Brevo template security rules", "file_type": "rationale", "source_file": "brevo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only params declared on the params: line, no contact.*, no unescaped output (|safe, autoescape off, raw), href/src only https:/mailto:/server-built *Url params, only *Url params inside HTML attributes because names/cities/dish titles/admin reasons are typed by people (some on a public form)."}, {"id": "brevo_readme_sign_in_url_invariant", "label": "signInUrl invariant", "file_type": "rationale", "source_file": "brevo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "APPLICATION_RECEIVED and SIGN_IN_LINK must keep href=params.signInUrl: it is the candidate's only way into their account."}, {"id": "brevo_readme_params_contract", "label": "params: line contract", "file_type": "concept", "source_file": "brevo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each template header declares its params; the backend mailer method must send exactly those params, and tests check templates use nothing else."}, {"id": "brevo_readme_upload_drift_detection", "label": "Upload digest drift detection", "file_type": "rationale", "source_file": "brevo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every upload stamps an 'uploaded <digest>' comment before </body>; --check uses it to tell a repo change from a Brevo editor edit, and --update refuses to overwrite a Brevo edit without --force."}, {"id": "brevo_readme_add_template_workflow", "label": "Add Brevo template workflow", "file_type": "concept", "source_file": "brevo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create templates/BREVO_TPL_<NAME>.html, register env var in env.validation.ts, config.loader.ts (brevo.templates) and .env.example, add a mailer method, run node --test, PR, then upload.mjs creates it and the id is set on Railway and .env."}], "edges": [{"source": "brevo_readme", "target": "brevo_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brevo/README.md", "source_location": null, "weight": 1.0}, {"source": "brevo_readme", "target": "brevo_templates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brevo/README.md", "source_location": null, "weight": 1.0}, {"source": "brevo_readme", "target": "brevo_upload", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brevo/README.md", "source_location": null, "weight": 1.0}, {"source": "brevo_readme", "target": "brevo_templates_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brevo/README.md", "source_location": null, "weight": 1.0}, {"source": "brevo_readme", "target": "brevo_upload_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brevo/README.md", "source_location": null, "weight": 1.0}, {"source": "brevo_readme_add_template_workflow", "target": "apps_src_config_env_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brevo/README.md", "source_location": null, "weight": 1.0}, {"source": "brevo_readme_add_tem