{"nodes": [{"id": "docs_database_connection_pooler_vs_direct", "label": "Pooler vs direct connection split", "file_type": "rationale", "source_file": "docs/database-connection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime Prisma and /ready use the transaction pooler (6543) while migrations use a direct or session connection (5432). Migrations must never run through the transaction pooler."}, {"id": "docs_database_connection_supabase_db_url", "label": "SUPABASE_DB_URL", "file_type": "concept", "source_file": "docs/database-connection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_database_connection_supabase_db_migration_url", "label": "SUPABASE_DB_MIGRATION_URL", "file_type": "concept", "source_file": "docs/database-connection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional; the CLI falls back to SUPABASE_DB_URL when unset. On Railway, if the direct db.<ref>.supabase.co host is unreachable (P1001), the session pooler on 5432 is the substitute."}, {"id": "docs_database_connection_prisma_config", "label": "apps/prisma.config.ts (Prisma 7)", "file_type": "concept", "source_file": "docs/database-connection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database URL, migrations path and seed command moved out of schema.prisma into the config file in ORM 7; seeding is explicit and no longer automatic after migrate."}, {"id": "docs_database_connection_idempotent_migrations", "label": "Idempotent migration rule", "file_type": "rationale", "source_file": "docs/database-connection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prisma does not wrap a migration file in a transaction, so a mid-file failure commits everything before it and migrate deploy replays from the top into already-exists errors. Migrations touching pre-existing objects therefore use guarded DO blocks, IF EXISTS/IF NOT EXISTS and ADD VALUE IF NOT EXISTS."}, {"id": "docs_database_connection_prisma_baseline", "label": "Prisma baseline for TypeORM databases", "file_type": "concept", "source_file": "docs/database-connection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "db:resolve --applied marks existing migrations as applied without re-running DDL, so a database created by the former TypeORM migrations can adopt Prisma without dropping data."}, {"id": "docs_database_connection_prismaservice", "label": "PrismaService runtime connection", "file_type": "concept", "source_file": "docs/database-connection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_database_connection_pooler_vs_direct", "target": "docs_database_connection_supabase_db_url", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/database-connection.md", "source_location": null, "weight": 1.0}, {"source": "docs_database_connection_pooler_vs_direct", "target": "docs_database_connection_supabase_db_migration_url", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/database-connection.md", "source_location": null, "weight": 1.0}, {"source": "docs_database_connection_prismaservice", "target": "docs_database_connection_supabase_db_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/database-connection.md", "source_location": null, "weight": 1.0}, {"source": "docs_database_connection_prisma_config", "target": "docs_database_connection_supabase_db_migration_url", "relation": "references", "confidence": "EXTRACTED", "conf