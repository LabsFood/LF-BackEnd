{"nodes": [{"id": "docs_payments_stripe_payments_contract_post_payments_intent", "label": "POST /payments/intent", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a client_secret so the backend never sees card details. Answers 409 when the booking is not pending, already paid, the chef's Connect onboarding is incomplete, or the amount is not positive."}, {"id": "docs_payments_stripe_payments_contract_intent_idempotency", "label": "PaymentIntent reuse idempotency", "file_type": "rationale", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second call returns the existing pending intent instead of creating another; an intent that can no longer be confirmed is dropped and replaced; and if Stripe already reports succeeded while the webhook is in flight the call answers 409 rather than double-billing."}, {"id": "docs_payments_stripe_payments_contract_post_webhooks_stripe", "label": "POST /webhooks/stripe", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public and unauthenticated, verified by the stripe-signature header. Excluded from Swagger with @ApiExcludeController; anything unhandled is logged at debug and ignored."}, {"id": "docs_payments_stripe_payments_contract_raw_body_verification", "label": "Raw-body signature verification", "file_type": "rationale", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Fastify preParsing hook in apps/src/main.ts captures the raw bytes for the paths listed in fastify-raw-body.ts, because a re-serialised JSON body fails Stripe's signature check."}, {"id": "docs_payments_stripe_payments_contract_webhook_idempotency", "label": "Webhook handler idempotency", "file_type": "rationale", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stripe delivers at least once and retries anything not 2xx, so every handler is a no-op on redelivery: a settled payment is skipped, a late payment_failed cannot undo it, an unchanged refund is not rewritten, and account.updated is an updateMany keyed on the account id."}, {"id": "docs_payments_stripe_payments_contract_computecommission", "label": "computeCommission()", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VAT is computed from the rounded HT amount so HT + VAT === TTC always holds; the total is clamped to the charge because Stripe rejects a fee larger than the charge and a misconfigured rate must not fail every payment; a zero commission sends no application_fee_amount at all."}, {"id": "docs_payments_stripe_payments_contract_commission_config", "label": "Commission configuration (bps)", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PAYMENTS_COMMISSION_RATE_BPS defaults to 1500 (the contracted 15% HT) and PAYMENTS_COMMISSION_VAT_RATE_BPS to 2000; both are bounded to 0..10000 in env.validation.ts and frozen onto each commission row."}, {"id": "docs_payments_stripe_payments_contract_stripe_connect_onboarding", "label": "Chef Stripe Connect onboarding routes", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Account links are single-use and short-lived so the URL must never be cached; status reads the Postgres flags mirrored from account.updated rather than the Stripe API, so the frontend can poll it cheaply."}, {"id": "docs_payments_stripe_payments_contract_payability_gate", "label": "Payability gate (chargesEnabled and payoutsEnabled)", "file_type": "rationale", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A booking whose chef has not finished onboarding answers 409, so the chef's onboarding state must be surfaced in the chef app before a client ever reaches checkout."}, {"id": "docs_payments_stripe_payments_contract_sepa_mandate_setupintent", "label": "SEPA mandate SetupIntent routes", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frontend collects the IBAN with Stripe Elements and confirms the SetupIntent there, so the IBAN never reaches the backend; setup_intent.succeeded stores the mandate id and ibanLast4."}, {"id": "docs_payments_stripe_payments_contract_sap_declaration_routes", "label": "GET/PATCH /me/chef-profile/sap", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upsert living in UsersModule, not PaymentsModule; switching declarationType clears the other type's fields so a cooperative chef cannot keep a stale NOVA code."}, {"id": "docs_payments_stripe_payments_contract_fiscal_attestations", "label": "Fiscal attestation routes", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only succeeded payments count and the tax year is decided by paidAt, not createdAt, so an intent created on 31 December and settled on 1 January belongs to the later year and a refund drops out on its own. JSON only, no signed PDF."}, {"id": "docs_payments_stripe_payments_contract_tax_credit_50", "label": "50% SAP tax credit (amountAfterTax)", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /bookings persists amountAfterTax = amountTtc / 2 per SPEC-BACKEND section 4.3."}, {"id": "docs_payments_stripe_payments_contract_refunds_passive", "label": "Refunds as passive bookkeeping", "file_type": "rationale", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commission.status is deliberately untouched on a refund because Stripe does not refund the application_fee_amount unless asked, so the commission really was collected. Clawing it back belongs to an admin refund flow that does not exist."}, {"id": "docs_payments_stripe_payments_contract_data_model", "label": "Payments data model (ER)", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "payments is not unique on booking_id; commissions is 1:1 with a payment and denormalises chef_profile_id because commission generated by chef X is a recurring admin query; payments.metadata is a deliberate extension slot for the avance immediate and CESU flows."}, {"id": "docs_payments_stripe_payments_contract_paid_status_unused", "label": "payment_status paid reserved and unset", "file_type": "rationale", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "paid is kept for the invoiceable step and no code path sets it; the implemented flow is pending to succeeded."}, {"id": "docs_payments_stripe_payments_contract_local_stripe_listen", "label": "Local stripe listen workflow", "file_type": "concept", "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stripe listen --forward-to localhost:8000/webhooks/stripe prints the whsec secret for repo-root .env; the .env.local precedence warning applies."}], "edges": [{"source": "docs_payments_stripe_payments_contract_post_payments_intent", "target": "docs_payments_stripe_payments_contract_computecommission", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_payments_stripe_payments_contract_post_payments_intent", "target": "docs_payments_stripe_payments_contract_intent_idempotency", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_payments_stripe_payments_contract_post_payments_intent", "target": "docs_payments_stripe_payments_contract_payability_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/payments/stripe-payments-contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_payments_stripe_payments_contract_payability_gate", "target": "docs_payments_stripe_payments_contract_stripe_connect_onboarding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/payments/stripe-payments-contract.md", 