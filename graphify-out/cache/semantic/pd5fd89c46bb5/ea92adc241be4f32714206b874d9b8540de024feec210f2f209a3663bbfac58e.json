{"nodes": [{"id": "_claude_plans_rework_37_account_at_submission", "label": "Rework #37: the account exists from candidature submission", "file_type": "document", "source_file": ".claude/plans/rework-37-account-at-submission.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_plans_rework_37_account_at_submission_sign_in_link_inbox_only", "label": "Sign-in link emailed only, never in the HTTP response", "file_type": "rationale", "source_file": ".claude/plans/rework-37-account-at-submission.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Email-ownership proof: the Clerk user has no password, so the inbox is the only way in; submitting someone else's address creates an account nobody can open. The link moves from approval to submission rather than disappearing."}, {"id": "_claude_plans_rework_37_account_at_submission_browse_only_enforcement", "label": "Browse-only candidate account enforced on the backend", "file_type": "concept", "source_file": ".claude/plans/rework-37-account-at-submission.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PATCH /me/chef-profile answers 403 CHEF_NOT_VERIFIED until verified; POST /bookings, POST /quotes and quote accept are not covered and wait on the self-dealing guard."}, {"id": "_claude_plans_rework_37_account_at_submission_verification_bypass", "label": "Admin verification bypass closed (PATCH /admin/chefs/:id/verification answers 409)", "file_type": "rationale", "source_file": ".claude/plans/rework-37-account-at-submission.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once every candidate holds a chef profile, setting isVerified directly would verify a candidate with no document check; refused unless the candidature is approved, and isActive refused on an unverified profile."}, {"id": "_claude_plans_rework_37_account_at_submission_reapply_path", "label": "Signed-in reapply (POST /me/chef-application/reapply)", "file_type": "rationale", "source_file": ".claude/plans/rework-37-account-at-submission.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public submission now refuses an email that already has an account, so without a signed-in path every refusal would become permanent despite the reapply date."}, {"id": "_claude_plans_rework_37_account_at_submission_candidate_token_removal", "label": "Opaque candidate token machinery removed (application-token, guard, resend-link)", "file_type": "concept", "source_file": ".claude/plans/rework-37-account-at-submission.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_plans_rework_37_account_at_submission_clerk_compensating_delete", "label": "Compensating Clerk user delete on submission transaction failure", "file_type": "concept", "source_file": ".claude/plans/rework-37-account-at-submission.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents an orphaned Clerk identity with no database row, and an address that could no longer apply."}], "edges": [{"source": "_claude_plans_rework_37_account_at_submission", "target": "_claude_plans_rework_37_account_at_submission_sign_in_link_inbox_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/rework-37-account-at-submission.md", "source_location": null, "weight": 1.0}, {"source": "_claude_plans_rework_37_account_at_submission", "target": "_claude_plans_rework_37_account_at_submission_browse_only_enforcement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/rework-37-account-at-sub