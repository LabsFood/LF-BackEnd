{"nodes": [{"id": "local_setup_guide", "label": "LOCAL_SETUP \u2014 run all four repos locally", "file_type": "document", "source_file": "LOCAL_SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "local_setup_four_repo_layout", "label": "Four repos cloned side by side", "file_type": "concept", "source_file": "LOCAL_SETUP.md", "source_location": "2. Cloner les 4 repos", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LF-BackEnd, batchcooking-web, labsfood-web and admin-dashboard must sit directly under the same parent because the orchestration docker-compose.yml references them by relative path."}, {"id": "local_setup_docker_everything", "label": "Everything in Docker to kill Node version drift", "file_type": "rationale", "source_file": "LOCAL_SETUP.md", "source_location": "Alternative sans Docker", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running every repo in a container is what removed the 'works on my machine' failures caused by different Node/npm versions across the four repos; the native npm install / npm run dev path still exists per repo but is explicitly not recommended."}, {"id": "local_setup_orchestration_files", "label": "local-dev/ orchestration files copied to the parent folder", "file_type": "concept", "source_file": "LOCAL_SETUP.md", "source_location": "3. Copier les fichiers d'orchestration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The multi-repo compose file and .env.example live in LF-BackEnd/local-dev/ because the shared parent directory is not itself a Git repo and cannot host them."}, {"id": "local_setup_troubleshooting", "label": "Local setup troubleshooting", "file_type": "concept", "source_file": "LOCAL_SETUP.md", "source_location": "6. Depannage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers the Postgres port collision (remap only the host side), desynchronised package-lock.json, missing Dockerfile on stale branches, and the requirement to use Git Bash on Windows because project scripts assume a Unix shell."}], "edges": [{"source": "local_setup_guide", "target": "agents_agents_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LOCAL_SETUP.md", "source_location": "3. Copier les fichiers d'orchestration", "weight": 1.0}, {"source": "local_setup_guide", "target": "local_setup_four_repo_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LOCAL_SETUP.md", "source_location": "2. Cloner les 4 repos", "weight": 1.0}, {"source": "local_setup_orchestration_files", "target": "local_setup_four_repo_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LOCAL_SETUP.md", "source_location": "3. Copier les fichiers d'orchestration", "weight": 1.0}, {"source": "local_setup_docker_everything", "target": "local_setup_guide", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LOCAL_SETUP.md", "source_location": "Alternative sans Docker", "weight": 1.0}, {"source": "local_setup_troubleshooting", "target": "docker_compose_postgres_service", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "LOCAL_SETUP.md", "source_location": "6. Depannage", "weight": 1.0}, {"source": "local_setup_orchestration_files", "target": "docker_compose_api_service", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "LOCAL_SETUP.md", "source_location": "3. Copier les fichiers d'orchestration", "weight": 1.0}], "hyperedges": []}