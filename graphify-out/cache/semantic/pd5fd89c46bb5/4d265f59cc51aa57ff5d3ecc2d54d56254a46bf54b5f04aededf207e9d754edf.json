{"nodes": [{"id": "docs_auth_clerk_supabase_sync_clerk_webhooks", "label": "POST /webhooks/clerk", "file_type": "concept", "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Svix-signed user.created/updated/deleted events verified with @clerk/backend verifyWebhook. Eventually consistent, so sign-in must never block on delivery."}, {"id": "docs_auth_clerk_supabase_sync_upsertfromclerkuserjson", "label": "UsersService.upsertFromClerkUserJson", "file_type": "concept", "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_auth_clerk_supabase_sync_deletebyclerkid", "label": "UsersService.deleteByClerkId", "file_type": "concept", "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_auth_clerk_supabase_sync_db_backfill_clerk", "label": "db:backfill:clerk script", "file_type": "concept", "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pulls Clerk accounts created before the webhook existed, or that never hit GET /me. Writes require --yes; existing rows keep their role so a backfill cannot silently demote an admin; email conflicts on a different clerk_user_id are reported and skipped rather than failing on the unique index."}, {"id": "docs_auth_clerk_supabase_sync_db_sync_clerk", "label": "db:sync:clerk script", "file_type": "concept", "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres to Clerk direction for demo/placeholder clerk_user_id rows. There is no Clerk Dashboard action to import Supabase users, so a script is the only path."}, {"id": "docs_auth_clerk_supabase_sync_env_precedence", "label": "loadRepoEnv precedence trap", "file_type": "rationale", "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repo-root .env.local overrides shell-exported variables, so exporting SUPABASE_DB_URL or CLERK_SECRET_KEY on the command line does not redirect the script. Always read the printed Database line before passing --yes."}, {"id": "docs_auth_clerk_supabase_sync_rbac_in_postgres", "label": "RBAC in Postgres only", "file_type": "rationale", "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "users.role in Postgres is the single source of truth; guards read the database, not Clerk metadata. Clerk proves identity and nothing more, so a compromised or stale Clerk publicMetadata cannot grant privileges."}, {"id": "docs_auth_clerk_supabase_sync_rls_boundary", "label": "Supabase RLS boundary", "file_type": "rationale", "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The API uses SUPABASE_DB_URL with Prisma as a service connection and never the Supabase JS client for users, so RLS applies only when a frontend talks to Supabase directly."}], "edges": [{"source": "docs_auth_clerk_supabase_sync_clerk_webhooks", "target": "docs_auth_clerk_supabase_sync_upsertfromclerkuserjson", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/auth/clerk-supabase-sync.md", "source_location": null, "weight": 1.0}, {"source": "docs_auth_clerk_supabase_sync_clerk_webhooks", "target": "docs_auth_clerk_supabase_sync_deletebyclerkid", "relation": "references", "confidence": "EXTRACTED", "confidence_s