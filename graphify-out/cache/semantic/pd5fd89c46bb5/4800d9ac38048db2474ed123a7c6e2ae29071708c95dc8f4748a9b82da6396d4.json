{"nodes": [{"id": "_claude_plans_handoff", "label": "HANDOFF: chef onboarding (FLOW-01) and dishes/menus (FLOW-02)", "file_type": "document", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_plans_handoff_standing_rules", "label": "Standing rules: read-only DB, commit only when asked, no attribution, frontends read-only", "file_type": "rationale", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User rules: never write to the database or apply a migration unasked (Docker Postgres unreliable, prefer Supabase read-only tooling); push only to the named remote branch; batchcooking-web and labsfood-web are read-only, stale docs are reported not edited; ponytail shortest correct diff."}, {"id": "_claude_plans_handoff_pr_37_batchcooker_chef_onboarding", "label": "PR #37 feat/batchcooker-chef-onboarding (FLOW-01 implementation)", "file_type": "concept", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_plans_handoff_pr_40_api_docs_and_cms_removal", "label": "PR #40 chore/api-docs-and-cms-removal", "file_type": "concept", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Based on #37's branch; retarget to develop once #37 merges because the Docker CI workflow only runs on PRs into develop."}, {"id": "_claude_plans_handoff_pr_38_chef_dishes_menus", "label": "PR #38 feat/chef-dishes-menus (FLOW-02 PRD and implementation)", "file_type": "concept", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_plans_handoff_public_account_creation_security_requirements", "label": "Security requirements for public account creation", "file_type": "rationale", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An email that already has an account must never gain a chef profile from an unauthenticated request (account-takeover path); throttle with ThrottlerGuard; no account enumeration; Clerk verifies the email before the account can act; privileged fields kept out of the body via forbidNonWhitelisted."}, {"id": "_claude_plans_handoff_clerk_user_deleted_anonymisation", "label": "Clerk user.deleted anonymisation (deleted_at tombstone)", "file_type": "rationale", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deletion blocked by bookings (P2003) anonymises the users row instead of retrying: bookings keep address_line and notes under GDPR art. 17(3)(b) because services-a-la-personne billing (tax certificate, URSSAF avance immediate) needs the client identity for years; the anonymised row resists a late user.updated, a hard-deleted one does not."}, {"id": "_claude_plans_handoff_flow_02_known_limits", "label": "FLOW-02 known limits (ponytail notes)", "file_type": "rationale", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately left: GET /menus/week and the moderation queue filter and page in memory; sessionFromCents ignores commission (lives on the payments branch); booking creation should call pinRecipes; a deleted dish leaves its R2 photo; anonymised chef candidature and identity documents kept until an end of contract is modelled."}, {"id": "_claude_plans_handoff_flow_02_deployment_prerequisites", "label": "FLOW-02 deployment prerequisites (apply migrations, Brevo templates, R2 bucket, English referential ids)", "file_type": "concept", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_plans_handoff_verification_gate", "label": "Verification gate: build, jest, lint checked by exit code", "file_type": "rationale", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checked by exit code because a piped tail once hid a failure; SUPABASE_DB_URL and SUPABASE_DB_MIGRATION_URL set to any postgres URL since the prisma config requires them though nothing connects."}, {"id": "_claude_plans_handoff_known_preexisting_issues", "label": "Known pre-existing issues: lint errors in src/generated, registerClient TTL test", "file_type": "concept", "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_plans_handoff", "target": "_claude_plans_handoff_standing_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "_claude_plans_handoff", "target": "_claude_plans_handoff_pr_37_batchcooker_chef_onboarding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "_claude_plans_handoff", "target": "_claude_plans_handoff_pr_40_api_docs_and_cms_removal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "_claude_plans_handoff", "target": "_claude_plans_handoff_pr_38_chef_dishes_menus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.