{"nodes": [{"id": "_claude_plans_api_docs_and_cms_removal_plan", "label": "Plan: API docs pass and CMS removal", "file_type": "document", "source_file": ".claude/plans/api-docs-and-cms-removal.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_plans_api_docs_and_cms_removal_plan_document_type_enum", "label": "Document-type enum in Swagger (DOCUMENT_TYPES derived from DOCUMENT_LABEL)", "file_type": "concept", "source_file": ".claude/plans/api-docs-and-cms-removal.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One source, kebab-case, in family order (blocking, conditional, recommended); behaviour unchanged, an unknown value is still 404."}, {"id": "_claude_plans_api_docs_and_cms_removal_plan_cms_removal", "label": "CMS removal (content-cms module, CmsPage model, cms_pages table)", "file_type": "rationale", "source_file": ".claude/plans/api-docs-and-cms-removal.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mistake from the start: neither frontend calls /content/concept and DEV holds only seed rows; default copy stays in git history. Applied migrations are left untouched because editing them breaks Prisma's checksum; Supabase stays for the KYC bucket."}, {"id": "_claude_plans_api_docs_and_cms_removal_plan_swagger_pass", "label": "Swagger pass on every route (summary, description, examples, error codes)", "file_type": "concept", "source_file": ".claude/plans/api-docs-and-cms-removal.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tags registered in the user's path through the product; admin routes get their own sections, with tags moved from class to method because Swagger merges class and method tags; enum values listed in lifecycle or family order with one line each."}, {"id": "_claude_plans_api_docs_and_cms_removal_plan_openapi_check_script", "label": "OpenAPI check script (NestFactory preview, no database)", "file_type": "concept", "source_file": ".claude/plans/api-docs-and-cms-removal.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swagger config moved from main.ts to src/swagger.ts buildOpenApiDocument(app) so the document builds without starting the server; fails on any operation lacking summary, description or success response, a {type} without enum, or a remaining /content path."}, {"id": "_claude_plans_api_docs_and_cms_removal_plan_documented_as_is_behaviours", "label": "Existing wrong behaviour documented as-is (POST /bookings 501, /bookings/me/bookings/:id, ...)", "file_type": "rationale", "source_file": ".claude/plans/api-docs-and-cms-removal.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documentation pass must not change behaviour; questionable behaviour is documented as it is and listed for the user to decide."}, {"id": "_claude_plans_api_docs_and_cms_removal_plan_get_bookings_no_admin_guard", "label": "GET /bookings returns every booking (no admin guard)", "file_type": "concept", "source_file": ".claude/plans/api-docs-and-cms-removal.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_plans_api_docs_and_cms_removal_plan", "target": "_claude_plans_api_docs_and_cms_removal_plan_document_type_enum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/api-docs-and-cms-removal.plan.md", "source_location": null, "weight": 1.0}, {"source": "_claude_plans_api_docs_and_cms_removal_plan", "target": "_claude_plans_api_docs_and_cms_removal_plan_cms_removal", "relation": "references", "confidence": "EXTRACTED",