{"nodes": [{"id": "agents_agents_guide", "label": "AGENTS.md \u2014 Cursor Cloud instructions", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_services_overview", "label": "Services overview (API 8000 / Postgres 5432 / Redis 6379)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Services overview", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_auth_testing_without_clerk", "label": "Auth testing without Clerk (sk_test_placeholder)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Auth testing without Clerk", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With CLERK_SECRET_KEY=sk_test_placeholder the guard decodes the JWT payload without JWKS verification, so any well-formed token with a sub claim works offline; a real sk_test_/sk_live_ key switches it back to @clerk/backend verifyToken. This keeps local and CI runs free of a Clerk dependency without weakening production."}, {"id": "agents_env_precedence_warning", "label": "Env precedence trap: .env.local overrides shell exports", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Clerk webhooks and DB sync", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "loadRepoEnv() lets repo-root .env.local override exported shell variables, so exporting SUPABASE_DB_URL does NOT redirect the sync scripts \u2014 they can reach hosted Postgres while you believe you are on localhost. Operators must read the 'Database :' line the script prints before writing."}, {"id": "agents_clerk_webhook_db_sync", "label": "Clerk webhooks and Postgres sync scripts", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Clerk webhooks and DB sync", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The route sets the role, never the body \u2014 a submitted role is a 400; chefs land is_active/is_verified = false until an admin verifies them. Backfill writes require --yes so the default is a dry run."}, {"id": "agents_payments_stripe", "label": "Payments (Stripe) operating notes", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Payments (Stripe)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /payments/intent charges what is left to pay rather than the booking total, and requires a pending booking owned by the caller plus a chef with chargesEnabled and payoutsEnabled, otherwise 409. Without STRIPE_SECRET_KEY every payment route answers 503."}, {"id": "agents_prefinanced_cesu", "label": "Prefinanced CESU operating notes", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Payments (Stripe)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The chef's CRCESU number (NAN) is published on a public GET /chefs/:id/cesu-info plus the booking detail and each quote, because a client needs it before paying. A CESU declaration may never exceed the remaining amount \u2014 CRCESU forbids any surcharge."}, {"id": "agents_commission_facture_b_sepa", "label": "Commission facture B collected by SEPA debit", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Payments (Stripe)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin triggers the monthly batch by hand (POST /admin/commission-invoices/run-due) \u2014 there is deliberately no cron. Never send on_behalf_of / transfer_data / application_fee_amount on a commission debit: it is a platform-to-chef receivable, not a marketplace charge."}, {"id": "agents_fiscal_attestation_platform_attestable", "label": "isPlatformAttestable predicate", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Payments (Stripe)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "platformAttestedAmountCents is narrower than the total: it excludes type B providers and e-CESU payments, because LAB'S FOOD can only attest what it is legally the seller of record for. A single predicate, isPlatformAttestable, keeps that rule in one place."}, {"id": "agents_webhook_raw_body_paths", "label": "WEBHOOK_RAW_BODY_PATHS registry", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Payments (Stripe)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any new signature-verified webhook path must be added to WEBHOOK_RAW_BODY_PATHS in apps/src/auth/fastify-raw-body.ts, otherwise the preParsing hook never captures its raw bytes and verification silently fails."}, {"id": "agents_f19_concept_cms", "label": "F19 concept CMS module note", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "F19 concept CMS", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_railway_production", "label": "Railway production deploy checklist", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Railway production", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SUPABASE_DB_URL points at the transaction pooler (:6543) while SUPABASE_DB_MIGRATION_URL must be a session or direct connection (:5432) \u2014 Prisma migrations cannot run through a transaction pooler."}], "edges": [{"source": "agents_agents_guide", "target": "docs_spec_backend_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Application specifiactions", "weight": 1.0}, {"source": "agents_agents_guide", "target": "docs_spec_admin_dashboard_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score":