{"nodes": [{"id": "_claude_prds_batchcooker_chef_onboarding_prd", "label": "PRD: batch cooker onboarding (candidature, KYC, admin validation)", "file_type": "document", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_flow_01_spec", "label": "FLOW-01 candidature batch cooker spec (batchcooking-web/docs/api)", "file_type": "document", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_account_at_submission", "label": "Submitting a candidature creates a browse-only account", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decided 21/09/2026, reversing FLOW-01 section 1: the candidate works signed in from a dashboard instead of through a scoped link, which removes the candidate token, its resend endpoint and account creation at approval. A refused candidate keeps the account and reapplies from it."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_verification_only_through_approval", "label": "Verification comes only from approval (409 DOCUMENT_REQUIRED)", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every candidate holds a chef profile, so the admin flag endpoint must refuse isVerified until approval, otherwise it skips the document check; approval itself is refused unless every blocking document is valid."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_self_promotion_removed", "label": "Client-to-chef self-promotion removed; PATCH /me/chef-profile is update-only", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two routes to becoming a chef, one unvetted, contradicted the premise; the route survives for verified self-edit only, a client gets 404 and a candidate 403."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_kyc_supabase_storage", "label": "KYC files in a private Supabase Storage bucket with signed upload and read", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already a configured dependency with a service-role key; at ~15 MB per chef storage cost is noise; the egress-price gap favouring object-storage vendors only matters for public high-traffic files, which KYC documents never are."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_brevo_hosted_templates", "label": "Transactional email via Brevo hosted templates (BREVO_TPL_* ids as config)", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "French candidate-facing copy including refusal reasons; wording can change without a backend deploy; template ids become configuration."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_daily_scheduled_job", "label": "Daily in-process scheduled job for expiry, suspension and retention", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No queue infrastructure exists and none is warranted at this scale; known ceiling is double-firing under multiple API replicas, mitigated by making the job idempotent."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_server_computed_requirements", "label": "Document requirements computed server-side from the candidate's answers", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Today requiredDocuments() lives hard-coded in the frontend, so nothing is actually required by any server."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_derived_dossier_status", "label": "Dossier status derived from documents, never stored as input", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An admin cannot type a dossier into validated; it follows from the documents."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_suspension_lifts_on_deposit", "label": "Automatic suspension lifts on deposit, not on review", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FLOW-01 section 7 promises the only unattended takedown is reversible immediately; the replacement document is flagged for priority review and a refusal re-suspends, so speed for the chef does not become a vetting hole."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_answer_lock", "label": "Answers correctable until decision, locked once a validated document proves them", "file_type": "rationale", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Otherwise a typo needs a refusal and reapplication; the lock keeps each admin decision tied to the answer it was made against. Email and consent never change."}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_services_a_la_personne", "label": "Service-a-la-personne regime (identity, registration and insurance evidence)", "file_type": "concept", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_success_metrics", "label": "FLOW-01 success metrics (funnel completion, 48h decision SLA, zero unevidenced chefs)", "file_type": "concept", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_batchcooker_chef_onboarding_prd_retention_purge", "label": "Retention purge on the FLOW-01 section 8 schedule", "file_type": "concept", "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open question: whether purge deletes stored files, rows or both, and how it reconciles with the contract plus 5 years obligation."}], "edges": [{"source": "_claude_prds_batchcooker_chef_onboarding_prd", "target": "_claude_prds_batchcooker_chef_onboarding_prd_flow_01_spec", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_batchcooker_chef_onboarding_prd", "target": "_claude_prds_chef_dishes_menus_prd_flow_02_spec", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/batchcooker-chef-onboarding.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_batchcooker_chef_onboarding