{"nodes": [{"id": "_claude_prds_chef_dishes_menus_prd", "label": "PRD: plats, menus, publication et moderation (FLOW-02)", "file_type": "document", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_flow_02_spec", "label": "FLOW-02 plats et menus spec (LF_Codespace root)", "file_type": "document", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_extend_meals_as_dish", "label": "Extend meals into the chef-owned dish (no second table)", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "meals already carries ~80% of the fields and booking_meals references it; with one table a suspended dish stays resolvable for prestations already booked, with two a booking would reference either table."}, {"id": "_claude_prds_chef_dishes_menus_prd_ownership_authorship_split", "label": "Ownership (chef_profile_id) separate from authorship (created_by_user_id)", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conflating them would make whoever typed a row its owner; an admin editing Lab's Food content must not lock it, any admin may edit it; created_by_user_id is attribution only; ownership changes only through the chef's own act (create, adopt, accept), never an admin write."}, {"id": "_claude_prds_chef_dishes_menus_prd_suggestions", "label": "Lab's Food suggestions (unowned, offered to no one, visible to every chef)", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_offers", "label": "Offers: content prepared for one chef, owned only on acceptance", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets Lab's Food build a menu for a batch cooker without imposing it (section 6, nothing is imposed); accepting transfers the row itself since no other chef needs the original; declining leaves it with Lab's Food."}, {"id": "_claude_prds_chef_dishes_menus_prd_adoption", "label": "Adoption: idempotent copy with lineage and audit-log consent", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previews carry no ingredients or steps and non-owner chefs have no recipe access, so adoption is what hands the recipe over; the original stays unowned so one chef adopting never takes it from another; idempotent per (chef, source) to absorb double clicks and dishes shared between menus."}, {"id": "_claude_prds_chef_dishes_menus_prd_chef_isolation", "label": "A chef never reads or copies another chef's content", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section 8 already withholds a recipe from every non-owner chef; this extends the rule to copying. The public vitrine is unaffected because its fields are public and never carry a recipe."}, {"id": "_claude_prds_chef_dishes_menus_prd_source_changed_flag", "label": "Safety-relevant edit to a suggestion flags its copies source-changed", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copies are insulated from bad edits but also from corrections; an edit to allergens, diets or country flags each copy, notifies its chef and queues it for review, never auto-applied nor auto-suspended because expiry stays the only unattended takedown."}, {"id": "_claude_prds_chef_dishes_menus_prd_direct_publication", "label": "Direct publication, moderation after the fact", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decided 20/09/2026; it makes the automatic checks the only barrier before a dish is public, so those checks are blocking (section 3.3)."}, {"id": "_claude_prds_chef_dishes_menus_prd_explicit_allergen_declaration", "label": "Explicit allergen declaration (allergens or allergensNone; custom values never count)", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An empty array cannot distinguish no allergens from not filled in; a free-text value like sarrasin must not satisfy the gate while the 14 regulated allergens stay unanswered."}, {"id": "_claude_prds_chef_dishes_menus_prd_menu_publish_cascade", "label": "Publishing a menu publishes its draft dishes, all or nothing", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes eight separate publications for an adopted 7-dish menu; section 3.4 already forbids a published menu containing a draft dish; lifts draft only, never suspended, so a moderation decision is not bypassed."}, {"id": "_claude_prds_chef_dishes_menus_prd_suspended_chef_owned_only", "label": "suspended status valid only for chef-owned rows (CHECK constraint)", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps archived (Lab's Food retired it) and suspended (a chef was moderated) from blurring into one column."}, {"id": "_claude_prds_chef_dishes_menus_prd_vitrine_monthly_rotation", "label": "Vitrine order: monthly-seeded rotation above a relevance floor", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordering decides who receives demand; rating-first would entrench early arrivals; one order per calendar month matches the Vitrine du mois cadence and keeps pagination stable; chefs with no menu for the week are listed last and marked rather than hidden."}, {"id": "_claude_prds_chef_dishes_menus_prd_dish_photos_r2", "label": "Dish, menu and profile photos on Cloudflare R2, presigned and moderated", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public storefront images are the high-egress case unlike KYC documents; R2 has no egress fee and speaks S3, so the presigned flow mirrors KYC with a closed list of image types, a size cap and every object under the owner's prefix so the path cannot host arbitrary files."}, {"id": "_claude_prds_chef_dishes_menus_prd_recipe_versioning", "label": "Recipes versioned; a prestation pins the version it was cooked from", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settles section 9.2: the fiche the client received and the one the API serves always agree and a dispute about what was cooked is answerable; the fiche flags a newer version with pinned and current numbers; re-pinning before the prestation is audited and regenerates the shopping list."}, {"id": "_claude_prds_chef_dishes_menus_prd_deterministic_shopping_lists", "label": "Shopping lists computed deterministically from structured ingredient lists", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "recipe.ingredients is validated as a list of {name, qty, unit, aisle} on every write path (legacy /admin/meals accepted only an object), so scaling, dedup by (name, unit) and grouping by aisle is arithmetic not inference; AI-generated lists are out of scope; chef corrections survive recalculation."}, {"id": "_claude_prds_chef_dishes_menus_prd_recipes_never_public", "label": "Recipes never exposed publicly (section 8)", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ingredients and steps are the chef's craft, handed to the client after the prestation and to admins for review, never on the vitrine."}, {"id": "_claude_prds_chef_dishes_menus_prd_menus_current_deprecated", "label": "GET /menus/current deprecated, every call logged", "file_type": "rationale", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No consumer exists in either frontend and GET /menus/week supersedes it; logging surfaces any outside consumer in Railway before removal."}, {"id": "_claude_prds_chef_dishes_menus_prd_chef_not_verified_gate", "label": "CHEF_NOT_VERIFIED publication gate", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_m1_dishes_have_owners", "label": "FLOW-02 M1: Dishes have owners", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_m2_chef_publishes_dish", "label": "FLOW-02 M2: A chef can publish a dish", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_m3_chef_publishes_week", "label": "FLOW-02 M3: A chef can publish a week", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_m4_start_from_labs_food", "label": "FLOW-02 M4: A chef can start from Lab's Food", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_m5_public_page_lists_cooks", "label": "FLOW-02 M5: The public page lists cooks, not dishes", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_m6_admin_moderation", "label": "FLOW-02 M6: Admins can moderate after the fact", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_m7_dish_photographs", "label": "FLOW-02 M7: Dishes have photographs", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_prds_chef_dishes_menus_prd_m8_prestation_documents", "label": "FLOW-02 M8: A prestation leaves its documents (fiche recette, shopping list, culinary map)", "file_type": "concept", "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_prds_chef_dishes_menus_prd", "target": "_claude_prds_chef_dishes_menus_prd_flow_02_spec", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_chef_dishes_menus_prd", "target": "_claude_prds_batchcooker_chef_onboarding_prd", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_chef_dishes_menus_prd", "target": "_claude_prds_chef_dishes_menus_prd_extend_meals_as_dish", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_chef_dishes_menus_prd", "target": "_claude_prds_chef_dishes_menus_prd_ownership_authorship_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/prds/chef-dishes-menus.prd.md", "source_location": null, "weight": 1.0}, {"source": "_claude_prds_chef_dishes_menus_prd", "target": "_claude_prds_chef_dishes_menus_prd_suggestions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".clau