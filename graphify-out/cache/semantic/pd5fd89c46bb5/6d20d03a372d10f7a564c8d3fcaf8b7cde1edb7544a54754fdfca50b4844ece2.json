cess_rule", "label": "One access rule: 404 on read, 403 CONTENT_NOT_OWNED on write", "file_type": "rationale", "source_file": ".claude/plans/chef-dishes-menus.architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChefContentService applies one rule on every chef path; another chef's row is 404 on reads so a chef cannot probe other chefs' ids; admin and public reads bypass it; the section 8 access table is one test across every actor."}, {"id": "_claude_plans_chef_dishes_menus_architecture_migration_per_milestone", "label": "One migration per milestone (none applied)", "file_type": "concept", "source_file": ".claude/plans/chef-dishes-menus.architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_plans_chef_dishes_menus_architecture_optional_integrations_degrade", "label": "Optional Brevo and R2 configuration degrades gracefully", "file_type": "rationale", "source_file": ".claude/plans/chef-dishes-menus.architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An email without a template id is a logged no-op and a photo route without R2 answers 503 PHOTOS_UNAVAILABLE, the same degradation FLOW-01 uses."}], "edges": [{"source": "_claude_plans_chef_dishes_menus_architecture", "target": "_claude_plans_chef_dishes_menus_architecture_spec_deviations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/chef-dishes-menus.architecture.md", "source_location": null, "weight": 1.0}, {"source": "_claude_plans_chef_dishes_menus_architecture", "target": "_claude_plans_chef_dishes_menus_architecture_dishes_module_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/chef-dishes-menus.architecture.md", "source_location": null, "wei