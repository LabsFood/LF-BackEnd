{"nodes": [{"id": "docs_spec_backend_spec", "label": "SPEC-BACKEND \u2014 Backend & Batch Cooking specification", "file_type": "document", "source_file": "docs/SPEC-BACKEND.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_backend_single_shared_backend", "label": "One API and one database for three frontends", "file_type": "rationale", "source_file": "docs/SPEC-BACKEND.md", "source_location": "1. Vue d'ensemble", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The vitrine site, the client space and the admin console share a single backend and a single database; the main site feeds the backend (contact forms, chef applications, Kossam orders) rather than owning its own store."}, {"id": "docs_spec_backend_reservation_lifecycle", "label": "Reservation lifecycle (pending \u2192 delivered)", "file_type": "concept", "source_file": "docs/SPEC-BACKEND.md", "source_location": "4.1 Cycle de vie d'une r\u00e9servation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pending \u2192 confirmed \u2192 shopping \u2192 cooking \u2192 delivered with a cancelled branch; a reference LF-AAAA-NNNN is generated at creation and each transition fires a notification."}, {"id": "docs_spec_backend_quote_lifecycle", "label": "Quote lifecycle (submitted \u2192 accepted)", "file_type": "concept", "source_file": "docs/SPEC-BACKEND.md", "source_location": "4.4 Devis sur-mesure", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "submitted \u2192 in-review \u2192 quoted \u2192 accepted (or declined); accepting a quote may generate a reservation."}, {"id": "docs_spec_backend_tax_credit_sap", "label": "50% SAP tax credit (cr\u00e9dit d'imp\u00f4t)", "file_type": "concept", "source_file": "docs/SPEC-BACKEND.md", "source_location": "4.3 Paiement & cr\u00e9dit d'imp\u00f4t", "source_url": null, "captu