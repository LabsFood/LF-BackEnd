{
  "branches": ["main"],
  "preset": "conventionalcommits",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    ["@semantic-release/npm", { "npmPublish": false, "pkgRoot": "apps" }],
    ["@semantic-release/git", { "assets": ["CHANGELOG.md", "apps/package.json", "apps/package-lock.json"] }],
    "@semantic-release/github"
  ]
}
