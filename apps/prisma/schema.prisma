enum ConversationType {
  chef_client
  support

  @@map("conversation_type")
}

enum MessageSenderRole {
  client
  chef
  support

  @@map("message_sender_role")
}

/// One thread. `chef_client`: exactly one per (client, chef) pair, whatever the
/// number of bookings between them. `support`: one per user, with the Lab's Food
/// team as a shared inbox, so admins hold no participant row.
model Conversation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             ConversationType
  /// Set for `chef_client` only, together with `chefProfileId`.
  clientId         String?          @map("client_id") @db.Uuid
  chefProfileId    String?          @map("chef_profile_id") @db.Uuid
  /// Set for `support` only: the user the thread belongs to.
  supportUserId    String?          @unique(map: "uq_conversations_support_user_id") @map("support_user_id") @db.Uuid
  /// Sorts the lists. Null until the first message.
  lastMessageAt    DateTime?        @map("last_message_at") @db.Timestamptz(6)
  /// When a phone number or an email was last detected in a participant's message.
  contactFlaggedAt DateTime?        @map("contact_flagged_at") @db.Timestamptz(6)
  /// Support threads only: messages the team has not opened yet.
  adminUnreadCount Int              @default(0) @map("admin_unread_count")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client       User?                     @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversations_client_id")
  chefProfile  ChefProfile?              @relation("ConversationChefProfile", fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversations_chef_profile_id")
  supportUser  User?                     @relation("ConversationSupportUser", fields: [supportUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversations_support_user_id")
  participants ConversationParticipant[]
  messages     Message[]
  attachments  MessageAttachment[]

  @@unique([clientId, chefProfileId], map: "uq_conversations_client_chef")
  @@index([chefProfileId], map: "ix_conversations_chef_profile_id")
  @@index([type, lastMessageAt], map: "ix_conversations_type_last_message_at")
  @@map("conversations")
}

/// Who may read and write a thread, and what they have not read yet.
model ConversationParticipant {
  conversationId String            @map("conversation_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  /// `client` or `chef`: the side this person writes from.
  role           MessageSenderRole
  /// Kept in step by the send and read transactions, so a list never counts rows.
  unreadCount    Int               @default(0) @map("unread_count")
  lastReadAt     DateTime?         @map("last_read_at") @db.Timestamptz(6)
  /// When the unread-message email last went out, so one burst sends one email.
  lastEmailedAt  DateTime?         @map("last_emailed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversation_participants_conversation_id")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conversation_participants_user_id")

  @@id([conversationId, userId], map: "pk_conversation_participants")
  @@index([userId], map: "ix_conversation_participants_user_id")
  @@map("conversation_participants")
}

/// `body` is always what the sender wrote. Phone numbers and emails are hidden
/// when the message is served, not when it is stored: admins read the original,
/// and the text comes back once the contact details are released (J-2).
model Message {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String            @map("conversation_id") @db.Uuid
  /// Null once the sender's account is deleted.
  senderUserId    String?           @map("sender_user_id") @db.Uuid
  senderRole      MessageSenderRole @map("sender_role")
  body            String
  contactDetected Boolean           @default(false) @map("contact_detected")
  /// Chosen by the sender's device, so a retried send does not post twice.
  clientMessageId String?           @map("client_message_id") @db.VarChar(64)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_messages_conversation_id")
  sender       User?               @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_messages_sender_user_id")
  attachments  MessageAttachment[]

  @@unique([conversationId, senderUserId, clientMessageId], map: "uq_messages_client_message_id")
  @@index([conversationId, createdAt], map: "ix_messages_conversation_created_at")
  @@map("messages")
}

/// A file sent with a message. It lives in the private messaging bucket and is
/// only ever read through a short-lived signed link.
model MessageAttachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  uploaderUserId String?  @map("uploader_user_id") @db.Uuid
  storagePath    String   @unique(map: "uq_message_attachments_storage_path") @map("storage_path") @db.VarChar(512)
  fileName       String   @map("file_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(127)
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_message_attachments_message_id")
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_message_attachments_conversation_id")
  uploader     User?        @relation("MessageAttachmentUploader", fields: [uploaderUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_message_attachments_uploader_user_id")

  @@index([messageId], map: "ix_message_attachments_message_id")
  @@map("message_attachments")
}

enum ContactMessageStatus {
  new
  read
  replied
  archived

  @@map("contact_message_status")
}

/// A message sent through a public contact form. The sender has no account: the
/// only way back to them is the email they typed.
model ContactMessage {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Which site the form is on: `labsfood` or `batchcooking`.
  source    String               @db.VarChar(24)
  name      String               @db.VarChar(255)
  email     String               @db.VarChar(320)
  phone     String?              @db.VarChar(32)
  subject   String               @db.VarChar(160)
  message   String
  status    ContactMessageStatus @default(new)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  replies ContactMessageReply[]

  @@index([status, createdAt], map: "ix_contact_messages_status_created_at")
  @@map("contact_messages")
}

/// What the team answered, as it was emailed. Kept so that the next admin reads
/// what was already said.
model ContactMessageReply {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactMessageId String   @map("contact_message_id") @db.Uuid
  body             String
  /// Null once the admin's account is deleted.
  sentByUserId     String?  @map("sent_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contactMessage ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contact_message_replies_contact_message_id")
  sentBy         User?          @relation("ContactReplySender", fields: [sentByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_contact_message_replies_sent_by_user_id")

  @@index([contactMessageId], map: "ix_contact_message_replies_contact_message_id")
  @@map("contact_message_replies")
}

// ── Payments (card, prefinanced CESU, commission invoices) ──

/// One row per payment attempt on a booking. Deliberately not unique on `bookingId`:
/// a failed CB attempt must be retryable with a fresh PaymentIntent, so a booking may
/// carry several rows — the most recent non-`failed` one is the live attempt.
model Payment {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId               String          @map("booking_id") @db.Uuid
  method                  PaymentMethod   @default(cb)
  status                  PaymentStatus   @default(pending)
  amountTtc               Int             @map("amount_ttc")
  currency                String          @default("EUR") @db.VarChar(3)
  stripePaymentIntentId   String?         @unique(map: "uq_payments_stripe_payment_intent_id") @map("stripe_payment_intent_id") @db.VarChar(128)
  stripeChargeId          String?         @map("stripe_charge_id") @db.VarChar(128)
  taxCreditEligibleAmount Int?            @map("tax_credit_eligible_amount")
  paidAt                  DateTime?       @map("paid_at") @db.Timestamptz(6)
  refundedAmount          Int?            @map("refunded_amount")
  refundedAt              DateTime?       @map("refunded_at") @db.Timestamptz(6)
  failureReason           String?         @map("failure_reason")
  /// Extension slot for the avance immédiate / CESU flows — avoids a throwaway migration.
  metadata                Json?
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking                 Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict, map: "fk_payments_booking_id")
  commission              Commission?
  cesuSettlement          CesuSettlement?

  /// `uq_payments_live_cesu_booking_id` — a partial unique index on
  /// (booking_id) WHERE method = 'cesu' AND status <> 'failed' — also guards this table.
  /// Prisma cannot express a partial index, so it lives only in the migration; do not
  /// "reconcile" the schema by dropping it.
  @@index([bookingId], map: "ix_payments_booking_id")
  @@index([status], map: "ix_payments_status")
  @@map("payments")
}

/// Platform commission on a payment. Rate and VAT are frozen at creation time so an
/// audit can replay the amounts even after the configured rate changes.
/// `chefProfileId` is denormalised (unlike on `Payment`) because "commission generated
/// by chef X" is a recurring admin query.
model Commission {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId           String                     @unique(map: "uq_commissions_payment_id") @map("payment_id") @db.Uuid
  chefProfileId       String                     @map("chef_profile_id") @db.Uuid
  rateBps             Int                        @map("rate_bps")
  vatRateBps          Int                        @map("vat_rate_bps")
  /// Amount the rate was applied to. Without it an audit cannot replay
  /// `rateBps x basisAmountCents = amountHtCents` on a booking paid in several
  /// instalments, because the booking total is no longer the base of any single line.
  basisAmountCents    Int                        @map("basis_amount_cents")
  amountHtCents       Int                        @map("amount_ht_cents")
  amountVatCents      Int                        @map("amount_vat_cents")
  amountTtcCents      Int                        @map("amount_ttc_cents")
  collectionMethod    CommissionCollectionMethod @default(stripe_application_fee) @map("collection_method")
  status              CommissionStatus           @default(pending)
  collectedAt         DateTime?                  @map("collected_at") @db.Timestamptz(6)
  /// Set when the commission is billed on a `CommissionInvoice` (facture B). Null while
  /// the commission is still `pending` and waiting for the monthly batch.
  commissionInvoiceId String?                    @map("commission_invoice_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment             Payment                    @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "fk_commissions_payment_id")
  chefProfile         ChefProfile                @relation(fields: [chefProfileId], references: [id], map: "fk_commissions_chef_profile_id")
  commissionInvoice   CommissionInvoice?         @relation(fields: [commissionInvoiceId], references: [id], map: "fk_commissions_commission_invoice_id")

  @@index([chefProfileId], map: "ix_commissions_chef_profile_id")
  @@index([commissionInvoiceId], map: "ix_commissions_commission_invoice_id")
  @@map("commissions")
}

/// "Service à la personne" declaration for a chef. Type A = the chef holds their own
/// NOVA declaration; Type B = the chef declares through a cooperative (Unipros-style).
/// Both external statuses stay inert until the URSSAF / CRCESU integrations exist.
model SapProfile {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId               String             @unique(map: "uq_sap_profiles_chef_profile_id") @map("chef_profile_id") @db.Uuid
  declarationType             SapDeclarationType @map("declaration_type")
  novaCode                    String?            @map("nova_code") @db.VarChar(64)
  urssafTiersPrestationStatus SapExternalStatus  @default(not_started) @map("urssaf_tiers_prestation_status")
  cooperativeName             String?            @map("cooperative_name") @db.VarChar(255)
  cooperativeMembershipProof  String?            @map("cooperative_membership_proof") @db.VarChar(512)
  crcesuNan                   String?            @map("crcesu_nan") @db.VarChar(64)
  crcesuAffiliationStatus     SapExternalStatus  @default(not_started) @map("crcesu_affiliation_status")
  /// Chef opt-in to being paid in prefinanced CESU. Eligibility is this flag **and** a
  /// `crcesuNan`: without the NAN a client cannot add the chef on their issuer's portal,
  /// so accepting the payment method would be a dead end.
  acceptsCesu                 Boolean            @default(false) @map("accepts_cesu")
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chefProfile                 ChefProfile        @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, map: "fk_sap_profiles_chef_profile_id")

  @@map("sap_profiles")
}

/// SEPA Direct Debit mandate used to collect the platform commission from the chef.
/// Foundation only: this phase records the mandate, it never debits. CB payments do
/// not require one — their commission is split by Stripe Connect at charge time.
model SepaMandate {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId         String            @unique(map: "uq_sepa_mandates_chef_profile_id") @map("chef_profile_id") @db.Uuid
  stripeCustomerId      String?           @map("stripe_customer_id") @db.VarChar(128)
  stripeSetupIntentId   String?           @map("stripe_setup_intent_id") @db.VarChar(128)
  stripePaymentMethodId String?           @map("stripe_payment_method_id") @db.VarChar(128)
  stripeMandateId       String?           @map("stripe_mandate_id") @db.VarChar(128)
  status                SepaMandateStatus @default(pending)
  ibanLast4             String?           @map("iban_last4") @db.VarChar(4)
  signedAt              DateTime?         @map("signed_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chefProfile           ChefProfile       @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, map: "fk_sepa_mandates_chef_profile_id")

  @@map("sepa_mandates")
}

/// A client's declaration that they paid a booking with prefinanced CESU, and the
/// chef's answer to it.
///
/// **The funds never transit through the platform**: the client pushes the payment from
/// their issuer's beneficiary area (Pluxee, Edenred, UP, BIMPLI, Domiserve) using the
/// chef's NAN, and the issuer credits the chef directly. No issuer exposes an API or a
/// normalised transaction reference, and Domiserve runs outside the CRCESU circuit
/// entirely, so **nothing here can be verified programmatically** — the chef confirms,
/// because the chef is who receives both the issuer's notification and the money.
///
/// Deliberately thin for paper CESU: no titre count, no millesime, no deposit date, no
/// reimbursed amount. The platform provides the payment method, the invoice and the
/// commission debit; depositing, validating and cashing paper titres is the chef's own
/// responsibility (CGU/CGV). Electronic CESU makes that moot anyway — the issuer's
/// portal refuses to spend an expired titre.
model CesuSettlement {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId             String               @unique(map: "uq_cesu_settlements_payment_id") @map("payment_id") @db.Uuid
  medium                CesuMedium
  /// Null for paper: the issuer only matters for the e-CESU support conversation.
  issuer                CesuIssuer?
  status                CesuSettlementStatus @default(declared)
  /// Free-text reference the client copies from their issuer's confirmation. Optional
  /// and not verifiable: the evidence is the document below.
  clientProofRef        String?              @map("client_proof_ref") @db.VarChar(255)
  /// The issuer's confirmation the client uploaded, in the private bucket. Required
  /// for e-CESU (a NOT VALID CHECK in 20261014120000_booking_flow_fields): Lab's
  /// Food's evidence if the batch cooker and the client disagree. The batch cooker
  /// still confirms receipt; the document never settles anything.
  clientProofPath       String?              @map("client_proof_path") @db.VarChar(255)
  clientProofUploadedAt DateTime?            @map("client_proof_uploaded_at") @db.Timestamptz(6)
  confirmedAt           DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  rejectionReason       String?              @map("rejection_reason")
  /// Who settled it. An admin force-settle writes a tax-credit line in a chef's name,
  /// so it is traced rather than indistinguishable from the chef's own confirmation.
  confirmedByUserId     String?              @map("confirmed_by_user_id") @db.Uuid
  adminOverride         Boolean              @default(false) @map("admin_override")
  adminProofRef         String?              @map("admin_proof_ref") @db.VarChar(255)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment               Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "fk_cesu_settlements_payment_id")
  confirmedBy           User?                @relation("CesuSettlementConfirmedBy", fields: [confirmedByUserId], references: [id], map: "fk_cesu_settlements_confirmed_by_user_id")

  @@index([status], map: "ix_cesu_settlements_status")
  @@map("cesu_settlements")
}

/// **Facture B** — the commission invoice the platform issues to the chef, and the legal
/// basis of the SEPA debit. The invoice always precedes the debit: a debit collects
/// against a receivable, it does not create one.
///
/// `paymentMethod` mirrors facture A's field and is what says whether the commission was
/// already withheld (`cb`, via `application_fee_amount`) or is still to be collected
/// (`cesu`, via direct debit).
///
/// `pdfObjectKey` / `s3ArchivedAt` are laid down empty on purpose: rendering and the
/// 10-year S3 retention belong to the invoicing workstream, which fills them without a
/// destructive migration. `LF-COM-<year>-NNNN` is **the** numbering scheme for facture B —
/// do not invent a second one.
model CommissionInvoice {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId    String                     @map("chef_profile_id") @db.Uuid
  invoiceNumber    String                     @unique(map: "uq_commission_invoices_invoice_number") @map("invoice_number") @db.VarChar(32)
  issuedAt         DateTime                   @default(now()) @map("issued_at") @db.Timestamptz(6)
  amountHtCents    Int                        @map("amount_ht_cents")
  amountVatCents   Int                        @map("amount_vat_cents")
  amountTtcCents   Int                        @map("amount_ttc_cents")
  /// Copied from the billed commissions and frozen, exactly like on `Commission`.
  rateBps          Int                        @map("rate_bps")
  vatRateBps       Int                        @map("vat_rate_bps")
  paymentMethod    PaymentMethod              @map("payment_method")
  collectionMethod CommissionCollectionMethod @map("collection_method")
  status           CommissionInvoiceStatus    @default(issued)
  /// Set only for a `monthly_batch` invoice; null when one payment produced one invoice.
  periodStart      DateTime?                  @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime?                  @map("period_end") @db.Timestamptz(6)
  pdfObjectKey     String?                    @map("pdf_object_key") @db.VarChar(512)
  s3ArchivedAt     DateTime?                  @map("s3_archived_at") @db.Timestamptz(6)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chefProfile      ChefProfile                @relation(fields: [chefProfileId], references: [id], onDelete: Restrict, map: "fk_commission_invoices_chef_profile_id")
  commissions      Commission[]
  debits           CommissionDebit[]

  @@index([chefProfileId], map: "ix_commission_invoices_chef_profile_id")
  @@index([status], map: "ix_commission_invoices_status")
  @@map("commission_invoices")
}

/// One **collection attempt** against a facture B. N debits for 1 invoice: a failed
/// debit does not cancel the receivable, so a retry reuses the invoice number instead of
/// burning a new one and leaving a hole in the sequence.
///
/// `clawbackWindowEndsAt` is `settledAt + 56 days`: under the SEPA **CORE** scheme — the
/// only one Stripe supports — the debtor can dispute "no questions asked" for 8 weeks and
/// the bank honours it automatically. A settled commission is therefore never final
/// before that date.
model CommissionDebit {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commissionInvoiceId   String                @map("commission_invoice_id") @db.Uuid
  /// Null between the row being created and the Stripe call returning. The row is
  /// written first on purpose: its id seeds the idempotency key, so a crash mid-call is
  /// repaired by replaying the identical request rather than by charging twice.
  stripePaymentIntentId String?               @unique(map: "uq_commission_debits_stripe_payment_intent_id") @map("stripe_payment_intent_id") @db.VarChar(128)
  amountTtcCents        Int                   @map("amount_ttc_cents")
  status                CommissionDebitStatus @default(pending)
  attemptNumber         Int                   @default(1) @map("attempt_number")
  failureReason         String?               @map("failure_reason")
  initiatedAt           DateTime?             @map("initiated_at") @db.Timestamptz(6)
  settledAt             DateTime?             @map("settled_at") @db.Timestamptz(6)
  clawbackWindowEndsAt  DateTime?             @map("clawback_window_ends_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  commissionInvoice     CommissionInvoice     @relation(fields: [commissionInvoiceId], references: [id], onDelete: Restrict, map: "fk_commission_debits_commission_invoice_id")

  @@index([commissionInvoiceId], map: "ix_commission_debits_commission_invoice_id")
  @@index([status], map: "ix_commission_debits_status")
  @@map("commission_debits")
}

/// Webhook de-duplication ledger.
///
/// The guard tests **`processedAt`**, not the mere existence of the row: a handler that
/// throws on the first delivery has already inserted its row, and an existence check
/// would then read Stripe's retry as a duplicate and drop the event for good.
model StripeEventLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String    @unique(map: "uq_stripe_event_logs_event_id") @map("event_id") @db.VarChar(128)
  type        String    @db.VarChar(128)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stripe_event_logs")
}

enum PaymentMethod {
  cb
  avance_immediate
  cesu

  @@map("payment_method")
}

/// Order matches the stored Postgres labels: pending -> succeeded (Stripe settled) ->
/// paid (invoiceable), with failed / refunded / partially_refunded as exit states.
enum PaymentStatus {
  pending
  succeeded
  /// Reserved for invoicing — **no code path sets this today**. A CB payment stops at
  /// `succeeded`, which is what the fiscal attestation totals count. Kept because the
  /// label predates this branch (`20250522130000_spec_domain`) and Prisma throws on an
  /// enum value it does not know, so dropping it here would break reads of any legacy
  /// row. Give it a writer or retire it deliberately — do not treat it as a synonym
  /// for `succeeded`.
  paid
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum CommissionCollectionMethod {
  stripe_application_fee
  sepa_direct_debit

  @@map("commission_collection_method")
}

/// `pending` -> `invoiced` (billed on a facture B) -> `processing` (a SEPA debit is in
/// flight) -> `collected`. `reversed` is the SEPA CORE clawback: the chef disputed within
/// the 8-week window, the bank honoured it, and the receivable is open again.
/// A card commission skips straight to `collected` — Stripe withholds it at charge time.
enum CommissionStatus {
  pending
  invoiced
  processing
  collected
  failed
  reversed

  @@map("commission_status")
}

enum SapDeclarationType {
  type_a_nova
  type_b_cooperative

  @@map("sap_declaration_type")
}

/// Shared by the URSSAF "tiers de prestation" habilitation and the CRCESU affiliation.
/// Inert this phase: no integration writes it, it is admin-maintained metadata.
enum SapExternalStatus {
  not_started
  pending
  active

  @@map("sap_external_status")
}

enum SepaMandateStatus {
  pending
  active
  revoked
  failed

  @@map("sepa_mandate_status")
}

/// Electronic CESU is the main circuit; paper is secondary and deliberately unmanaged
/// (see `CesuSettlement`).
enum CesuMedium {
  ecesu
  cesu_paper

  @@map("cesu_medium")
}

/// The five issuers a French beneficiary can hold a prefinanced CESU account with.
/// `domiserve` runs its own circuit outside the CRCESU, which changes nothing here —
/// no issuer is queryable either way.
enum CesuIssuer {
  pluxee
  edenred
  up
  bimpli
  domiserve
  other

  @@map("cesu_issuer")
}

enum CesuSettlementStatus {
  declared
  confirmed
  rejected

  @@map("cesu_settlement_status")
}

/// `issued` is the only status that makes a commission collectable. `settled` means a
/// debit succeeded; `written_off` is the admin's give-up, never an automatic transition.
enum CommissionInvoiceStatus {
  issued
  settled
  written_off

  @@map("commission_invoice_status")
}

/// Mirrors the SEPA PaymentIntent lifecycle. Note the absence of a Stripe `failed`
/// status: a late SEPA failure moves the PaymentIntent to `requires_payment_method`,
/// which this enum records as `failed`.
enum CommissionDebitStatus {
  pending
  processing
  succeeded
  failed
  canceled
  reversed

  @@map("commission_debit_status")
}

/// The URSSAF "avance immédiate" enrolment of **one client with one batch cooker**.
/// The immediate advance exists per pair: a client enrolled with one cook cannot use
/// it for a prestation by another (FLOW-03 §1.2), which is why this is a table and not
/// a flag on the account.
///
/// ponytail: `pending` to `active` or `refused` is decided by URSSAF. Until the API
/// access exists, an admin plays URSSAF (`POST /admin/urssaf-links/{id}/decision`), and
/// only while `URSSAF_GATEWAY=simulated`.
model UrssafLink {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String           @map("client_id") @db.Uuid
  chefProfileId String           @map("chef_profile_id") @db.Uuid
  status        UrssafLinkStatus @default(pending)
  refusalReason String?          @map("refusal_reason")
  requestedAt   DateTime         @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt     DateTime?        @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client        User             @relation("UrssafLinkClient", fields: [clientId], references: [id], onDelete: Cascade, map: "fk_urssaf_links_client_id")
  chefProfile   ChefProfile      @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, map: "fk_urssaf_links_chef_profile_id")

  @@unique([clientId, chefProfileId], map: "uq_urssaf_links_client_chef")
  @@index([status], map: "ix_urssaf_links_status")
  @@map("urssaf_links")
}

enum UrssafLinkStatus {
  pending
  active
  refused

  @@map("urssaf_link_status")
}

/// What a prestation left behind: plated dishes, labelled containers, the kitchen
/// handed back. The booking's batch cooker adds them once the prestation started;
/// the client and admins see them with the report. Public R2 object under an
/// unguessable key, like dish photos.
model BookingPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  url       String   @db.VarChar(512)
  caption   String?  @db.VarChar(160)
  takenAt   DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_photos_booking_id")

  @@index([bookingId, takenAt], map: "ix_booking_photos_booking_taken_at")
  @@map("booking_photos")
}

/// One range of a batch cooker's weekly template. Minutes since midnight, Paris
/// time; `weekday` 0 is Monday, as `WEEKDAYS` in batchcooking-web's agenda.
model ChefWorkingHour {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId String      @map("chef_profile_id") @db.Uuid
  weekday       Int
  startMinute   Int         @map("start_minute")
  endMinute     Int         @map("end_minute")
  chefProfile   ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chef_working_hours_chef_profile_id")

  @@index([chefProfileId], map: "ix_chef_working_hours_chef_profile_id")
  @@map("chef_working_hours")
}

/// A day off the template: `closed` removes the day, `extra` adds a range to it.
model ChefAvailabilityException {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId String      @map("chef_profile_id") @db.Uuid
  date          DateTime    @db.Date
  /// `extra` | `closed`.
  kind          String      @db.VarChar(8)
  startMinute   Int?        @map("start_minute")
  endMinute     Int?        @map("end_minute")
  reason        String?     @db.VarChar(255)
  chefProfile   ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chef_availability_exceptions_chef_profile_id")

  @@index([chefProfileId, date], map: "ix_chef_availability_exceptions_chef_date")
  @@map("chef_availability_exceptions")
}

/// Time the batch cooker blocks in their agenda (a dentist, a holiday afternoon):
/// busy for bookings, never covering one.
model ChefTimeBlock {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId String      @map("chef_profile_id") @db.Uuid
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(6)
  /// The batch cooker's own words. Never logged.
  reason        String?     @db.VarChar(255)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  chefProfile   ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chef_time_blocks_chef_profile_id")

  /// The same block twice is a double click: the second create finds the first.
  @@unique([chefProfileId, startsAt, endsAt], map: "uq_chef_time_blocks_chef_range")
  @@map("chef_time_blocks")
}

/// A new time one side of a confirmed booking proposes and the other confirms
/// (in-house calendar, phase D3). One open proposal per booking: a partial unique
/// index in the migration.
model BookingReschedule {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String    @map("booking_id") @db.Uuid
  /// `client` | `chef`.
  proposedByRole   String    @map("proposed_by_role") @db.VarChar(8)
  proposedByUserId String?   @map("proposed_by_user_id") @db.Uuid
  fromStartsAt     DateTime  @map("from_starts_at") @db.Timestamptz(6)
  toStartsAt       DateTime  @map("to_starts_at") @db.Timestamptz(6)
  /// `pending` | `accepted` | `declined` | `withdrawn` | `expired`.
  status           String    @default("pending") @db.VarChar(10)
  /// 48 h after it is made, or 48 h before the booking's start, whichever is first.
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_booking_reschedules_booking_id")
  proposedBy       User?     @relation("BookingRescheduleProposer", fields: [proposedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_booking_reschedules_proposed_by_user_id")

  @@index([bookingId, createdAt], map: "ix_booking_reschedules_booking_created_at")
  @@index([status, expiresAt], map: "ix_booking_reschedules_status_expires_at")
  @@map("booking_reschedules")
}

/// The private link a batch cooker subscribes their calendar app to (Google,
/// Outlook, Apple). Only the token's SHA-256 is kept: the link is shown once.
/// No row: the feed is off.
model ChefCalendarFeed {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId String      @unique(map: "uq_chef_calendar_feeds_chef_profile_id") @map("chef_profile_id") @db.Uuid
  tokenHash     String      @unique(map: "uq_chef_calendar_feeds_token_hash") @map("token_hash") @db.VarChar(64)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt     DateTime?   @map("rotated_at") @db.Timestamptz(6)
  /// When a calendar app last fetched it, written at most once an hour. Recent
  /// enough, the batch cooker's calendar is synced (`calendarConnected`).
  lastFetchedAt DateTime?   @map("last_fetched_at") @db.Timestamptz(6)
  chefProfile   ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chef_calendar_feeds_chef_profile_id")

  @@map("chef_calendar_feeds")
}
