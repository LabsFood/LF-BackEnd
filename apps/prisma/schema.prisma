  written_off

  @@map("commission_invoice_status")
}

/// Mirrors the SEPA PaymentIntent lifecycle. Note the absence of a Stripe `failed`
/// status: a late SEPA failure moves the PaymentIntent to `requires_payment_method`,
/// which this enum records as `failed`.
enum CommissionDebitStatus {
  pending
  processing
  succeeded
  failed
  canceled
  reversed

  @@map("commission_debit_status")
}
