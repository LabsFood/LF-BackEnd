generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId              String           @unique(map: "uq_users_clerk_user_id") @map("clerk_user_id") @db.VarChar(128)
  email                    String           @unique(map: "uq_users_email") @db.VarChar(320)
  fullName                 String?          @map("full_name") @db.VarChar(255)
  role                     UserRole         @default(client)
  phone                    String?          @db.VarChar(32)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingsAsClient         Booking[]        @relation("BookingClient")
  cmsPagesUpdated          CmsPage[]        @relation("CmsPageUpdatedBy")
  chefProfile              ChefProfile?
  clientProfile            ClientProfile?
  quotes                   Quote[]          @relation("QuoteClient")
  cesuSettlementsConfirmed CesuSettlement[] @relation("CesuSettlementConfirmedBy")

  @@map("users")
}

model ChefProfile {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String              @unique(map: "uq_chef_profiles_user_id") @map("user_id") @db.Uuid
  displayName            String              @map("display_name") @db.VarChar(255)
  bio                    String?
  city                   String?             @db.VarChar(120)
  serviceRadiusKm        Int                 @default(10) @map("service_radius_km")
  isActive               Boolean             @default(false) @map("is_active")
  isVerified             Boolean             @default(false) @map("is_verified")
  cronofyProfileId       String?             @map("cronofy_profile_id") @db.VarChar(128)
  stripeAccountId        String?             @map("stripe_account_id") @db.VarChar(128)
  // Mirrored 1:1 from the Stripe `account.updated` webhook — never set by hand.
  stripeChargesEnabled   Boolean             @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled   Boolean             @default(false) @map("stripe_payouts_enabled")
  stripeDetailsSubmitted Boolean             @default(false) @map("stripe_details_submitted")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  availabilitySlots      AvailabilitySlot[]
  bookings               Booking[]           @relation("BookingChefProfile")
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chef_profiles_user_id")
  serviceOffers          ServiceOffer[]
  sapProfile             SapProfile?
  sepaMandate            SepaMandate?
  commissions            Commission[]
  commissionInvoices     CommissionInvoice[]

  @@map("chef_profiles")
}

model ServiceOffer {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId   String      @map("provider_id") @db.Uuid
  name            String      @db.VarChar(160)
  description     String?
  durationMinutes Int         @map("duration_minutes")
  priceCents      Int         @map("price_cents")
  currency        String      @default("EUR") @db.VarChar(3)
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings        Booking[]
  chefProfile     ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_service_offers_chef_profile_id")

  @@index([chefProfileId], map: "ix_service_offers_chef_profile_id")
  @@map("service_offers")
}

model AvailabilitySlot {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId String      @map("provider_id") @db.Uuid
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(6)
  isBooked      Boolean     @default(false) @map("is_booked")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chefProfile   ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_availability_slots_chef_profile_id")

  @@index([chefProfileId], map: "ix_availability_slots_chef_profile_id")
  @@map("availability_slots")
}

model Booking {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference             String?       @unique(map: "bookings_reference_key") @db.VarChar(32)
  clientId              String        @map("client_id") @db.Uuid
  chefProfileId         String        @map("provider_id") @db.Uuid
  serviceOfferId        String        @map("service_offer_id") @db.Uuid
  formuleId             String?       @map("formule_id") @db.VarChar(32)
  bookingDate           DateTime?     @map("booking_date") @db.Date
  timeSlot              String?       @map("time_slot") @db.VarChar(64)
  persons               Int?
  startsAt              DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime      @map("ends_at") @db.Timestamptz(6)
  status                BookingStatus @default(pending)
  priceCents            Int           @map("price_cents")
  amountTtc             Int?          @map("amount_ttc")
  amountAfterTax        Int?          @map("amount_after_tax")
  currency              String        @default("EUR") @db.VarChar(3)
  shoppingByClient      Boolean       @default(false) @map("shopping_by_client")
  addressLine           String?       @map("address_line") @db.VarChar(255)
  notes                 String?
  stripePaymentIntentId String?       @map("stripe_payment_intent_id") @db.VarChar(128)
  cronofyEventId        String?       @map("cronofy_event_id") @db.VarChar(128)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingMeals          BookingMeal[]
  client                User          @relation("BookingClient", fields: [clientId], references: [id], onUpdate: NoAction, map: "fk_bookings_client_id")
  chefProfile           ChefProfile   @relation("BookingChefProfile", fields: [chefProfileId], references: [id], onUpdate: NoAction, map: "fk_bookings_chef_profile_id")
  formule               Formule?      @relation(fields: [formuleId], references: [id], onUpdate: NoAction, map: "bookings_formule_id_fkey")
  shoppingList          ShoppingList?
  serviceOffer          ServiceOffer  @relation(fields: [serviceOfferId], references: [id], onUpdate: NoAction, map: "fk_bookings_service_offer_id")
  payments              Payment[]

  @@index([clientId], map: "ix_bookings_client_id")
  @@index([chefProfileId], map: "ix_bookings_chef_profile_id")
  @@map("bookings")
}

model CmsPage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String   @unique(map: "uq_cms_pages_slug") @db.VarChar(255)
  title            String   @db.VarChar(255)
  hero             Json
  introBlocks      Json     @map("intro_blocks")
  howItWorks       Json     @map("how_it_works")
  reassuranceItems Json     @map("reassurance_items")
  status           String   @default("published") @db.VarChar(32)
  updatedByUserId  String?  @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        User?    @relation("CmsPageUpdatedBy", fields: [updatedByUserId], references: [id], onUpdate: NoAction, map: "fk_cms_pages_updated_by_user_id")

  @@map("cms_pages")
}

model ClientProfile {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @unique(map: "client_profiles_user_id_key") @map("user_id") @db.Uuid
  dietaryPreferences String[]            @default([]) @map("dietary_preferences")
  allergies          String[]            @default([])
  dislikes           String[]            @default([])
  favorites          String[]            @default([])
  spiceLevel         Int?                @map("spice_level")
  householdAdults    Int                 @default(1) @map("household_adults")
  householdKids      Int                 @default(0) @map("household_kids")
  kitchenNotes       String?             @map("kitchen_notes")
  addressStreet      String?             @map("address_street") @db.VarChar(255)
  addressCity        String?             @map("address_city") @db.VarChar(120)
  addressPostalCode  String?             @map("address_postal_code") @db.VarChar(16)
  status             ClientProfileStatus @default(active)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_profiles_user_id_fkey")

  @@map("client_profiles")
}

model Meal {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String          @db.VarChar(255)
  description  String?
  imageUrl     String?         @map("image_url") @db.VarChar(512)
  continent    MealContinent?
  country      String?         @db.VarChar(120)
  portions     Int             @default(4)
  prepTime     Int             @map("prep_time")
  dietaryTags  String[]        @default([]) @map("dietary_tags")
  allergens    String[]        @default([])
  calories     Int?
  difficulty   MealDifficulty?
  ingredients  Json            @default("[]")
  steps        String[]        @default([])
  isFeatured   Boolean         @default(false) @map("is_featured")
  status       MealStatus      @default(draft)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingMeals BookingMeal[]
  menuWeeks    MenuWeekMeal[]

  @@map("meals")
}

model MenuWeek {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekNumber  Int            @map("week_number")
  year        Int
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  meals       MenuWeekMeal[]

  @@unique([year, weekNumber], map: "uq_menu_weeks_year_week")
  @@map("menu_weeks")
}

model MenuWeekMeal {
  menuWeekId String   @map("menu_week_id") @db.Uuid
  mealId     String   @map("meal_id") @db.Uuid
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "menu_week_meals_meal_id_fkey")
  menuWeek   MenuWeek @relation(fields: [menuWeekId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "menu_week_meals_menu_week_id_fkey")

  @@id([menuWeekId, mealId])
  @@map("menu_week_meals")
}

model Formule {
  id            String    @id @db.VarChar(32)
  name          String    @db.VarChar(120)
  priceTtc      Int       @map("price_ttc")
  priceAfterTax Int       @map("price_after_tax")
  duration      String    @db.VarChar(64)
  mealsCount    Int       @map("meals_count")
  persons       String    @db.VarChar(64)
  features      String[]  @default([])
  popular       Boolean   @default(false)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings      Booking[]

  @@map("formules")
}

model BookingMeal {
  bookingId String  @map("booking_id") @db.Uuid
  mealId    String  @map("meal_id") @db.Uuid
  portions  Int     @default(4)
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "booking_meals_booking_id_fkey")
  meal      Meal    @relation(fields: [mealId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "booking_meals_meal_id_fkey")

  @@id([bookingId, mealId])
  @@map("booking_meals")
}

model ShoppingList {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String         @unique(map: "shopping_lists_booking_id_key") @map("booking_id") @db.Uuid
  generatedAt DateTime       @default(now()) @map("generated_at") @db.Timestamptz(6)
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shopping_lists_booking_id_fkey")
  items       ShoppingItem[]

  @@map("shopping_lists")
}

model ShoppingItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shoppingListId String       @map("shopping_list_id") @db.Uuid
  aisle          String       @db.VarChar(120)
  name           String       @db.VarChar(255)
  quantity       String       @db.VarChar(64)
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shopping_items_shopping_list_id_fkey")

  @@index([shoppingListId], map: "ix_shopping_items_list_id")
  @@map("shopping_items")
}

model Quote {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference           String      @unique(map: "quotes_reference_key") @db.VarChar(32)
  clientId            String      @map("client_id") @db.Uuid
  title               String      @db.VarChar(255)
  persons             Int
  mealsCount          Int         @map("meals_count")
  cuisine             String      @db.VarChar(120)
  diet                String[]    @default([])
  brief               String
  status              QuoteStatus @default(submitted)
  assignedChefUserId  String?     @map("assigned_chef_user_id") @db.Uuid
  quoteAmountTtc      Int?        @map("quote_amount_ttc")
  quoteAmountAfterTax Int?        @map("quote_amount_after_tax")
  quoteNote           String?     @map("quote_note")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client              User        @relation("QuoteClient", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "quotes_client_id_fkey")

  @@index([clientId], map: "ix_quotes_client_id")
  @@map("quotes")
}

/// One row per payment attempt on a booking. Deliberately not unique on `bookingId`:
/// a failed CB attempt must be retryable with a fresh PaymentIntent, so a booking may
/// carry several rows — the most recent non-`failed` one is the live attempt.
model Payment {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId               String          @map("booking_id") @db.Uuid
  method                  PaymentMethod   @default(cb)
  status                  PaymentStatus   @default(pending)
  amountTtc               Int             @map("amount_ttc")
  currency                String          @default("EUR") @db.VarChar(3)
  stripePaymentIntentId   String?         @unique(map: "uq_payments_stripe_payment_intent_id") @map("stripe_payment_intent_id") @db.VarChar(128)
  stripeChargeId          String?         @map("stripe_charge_id") @db.VarChar(128)
  taxCreditEligibleAmount Int?            @map("tax_credit_eligible_amount")
  paidAt                  DateTime?       @map("paid_at") @db.Timestamptz(6)
  refundedAmount          Int?            @map("refunded_amount")
  refundedAt              DateTime?       @map("refunded_at") @db.Timestamptz(6)
  failureReason           String?         @map("failure_reason")
  /// Extension slot for the avance immédiate / CESU flows — avoids a throwaway migration.
  metadata                Json?
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking                 Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict, map: "fk_payments_booking_id")
  commission              Commission?
  cesuSettlement          CesuSettlement?

  /// `uq_payments_live_cesu_booking_id` — a partial unique index on
  /// (booking_id) WHERE method = 'cesu' AND status <> 'failed' — also guards this table.
  /// Prisma cannot express a partial index, so it lives only in the migration; do not
  /// "reconcile" the schema by dropping it.
  @@index([bookingId], map: "ix_payments_booking_id")
  @@index([status], map: "ix_payments_status")
  @@map("payments")
}

/// Platform commission on a payment. Rate and VAT are frozen at creation time so an
/// audit can replay the amounts even after the configured rate changes.
/// `chefProfileId` is denormalised (unlike on `Payment`) because "commission generated
/// by chef X" is a recurring admin query.
model Commission {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId           String                     @unique(map: "uq_commissions_payment_id") @map("payment_id") @db.Uuid
  chefProfileId       String                     @map("chef_profile_id") @db.Uuid
  rateBps             Int                        @map("rate_bps")
  vatRateBps          Int                        @map("vat_rate_bps")
  /// Amount the rate was applied to. Without it an audit cannot replay
  /// `rateBps x basisAmountCents = amountHtCents` on a booking paid in several
  /// instalments, because the booking total is no longer the base of any single line.
  basisAmountCents    Int                        @map("basis_amount_cents")
  amountHtCents       Int                        @map("amount_ht_cents")
  amountVatCents      Int                        @map("amount_vat_cents")
  amountTtcCents      Int                        @map("amount_ttc_cents")
  collectionMethod    CommissionCollectionMethod @default(stripe_application_fee) @map("collection_method")
  status              CommissionStatus           @default(pending)
  collectedAt         DateTime?                  @map("collected_at") @db.Timestamptz(6)
  /// Set when the commission is billed on a `CommissionInvoice` (facture B). Null while
  /// the commission is still `pending` and waiting for the monthly batch.
  commissionInvoiceId String?                    @map("commission_invoice_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment             Payment                    @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "fk_commissions_payment_id")
  chefProfile         ChefProfile                @relation(fields: [chefProfileId], references: [id], map: "fk_commissions_chef_profile_id")
  commissionInvoice   CommissionInvoice?         @relation(fields: [commissionInvoiceId], references: [id], map: "fk_commissions_commission_invoice_id")

  @@index([chefProfileId], map: "ix_commissions_chef_profile_id")
  @@index([commissionInvoiceId], map: "ix_commissions_commission_invoice_id")
  @@map("commissions")
}

/// "Service à la personne" declaration for a chef. Type A = the chef holds their own
/// NOVA declaration; Type B = the chef declares through a cooperative (Unipros-style).
/// Both external statuses stay inert until the URSSAF / CRCESU integrations exist.
model SapProfile {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId               String             @unique(map: "uq_sap_profiles_chef_profile_id") @map("chef_profile_id") @db.Uuid
  declarationType             SapDeclarationType @map("declaration_type")
  novaCode                    String?            @map("nova_code") @db.VarChar(64)
  urssafTiersPrestationStatus SapExternalStatus  @default(not_started) @map("urssaf_tiers_prestation_status")
  cooperativeName             String?            @map("cooperative_name") @db.VarChar(255)
  cooperativeMembershipProof  String?            @map("cooperative_membership_proof") @db.VarChar(512)
  crcesuNan                   String?            @map("crcesu_nan") @db.VarChar(64)
  crcesuAffiliationStatus     SapExternalStatus  @default(not_started) @map("crcesu_affiliation_status")
  /// Chef opt-in to being paid in prefinanced CESU. Eligibility is this flag **and** a
  /// `crcesuNan`: without the NAN a client cannot add the chef on their issuer's portal,
  /// so accepting the payment method would be a dead end.
  acceptsCesu                 Boolean            @default(false) @map("accepts_cesu")
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chefProfile                 ChefProfile        @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, map: "fk_sap_profiles_chef_profile_id")

  @@map("sap_profiles")
}

/// SEPA Direct Debit mandate used to collect the platform commission from the chef.
/// Foundation only: this phase records the mandate, it never debits. CB payments do
/// not require one — their commission is split by Stripe Connect at charge time.
model SepaMandate {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId         String            @unique(map: "uq_sepa_mandates_chef_profile_id") @map("chef_profile_id") @db.Uuid
  stripeCustomerId      String?           @map("stripe_customer_id") @db.VarChar(128)
  stripeSetupIntentId   String?           @map("stripe_setup_intent_id") @db.VarChar(128)
  stripePaymentMethodId String?           @map("stripe_payment_method_id") @db.VarChar(128)
  stripeMandateId       String?           @map("stripe_mandate_id") @db.VarChar(128)
  status                SepaMandateStatus @default(pending)
  ibanLast4             String?           @map("iban_last4") @db.VarChar(4)
  signedAt              DateTime?         @map("signed_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chefProfile           ChefProfile       @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, map: "fk_sepa_mandates_chef_profile_id")

  @@map("sepa_mandates")
}

/// A client's declaration that they paid a booking with prefinanced CESU, and the
/// chef's answer to it.
///
/// **The funds never transit through the platform**: the client pushes the payment from
/// their issuer's beneficiary area (Pluxee, Edenred, UP, BIMPLI, Domiserve) using the
/// chef's NAN, and the issuer credits the chef directly. No issuer exposes an API or a
/// normalised transaction reference, and Domiserve runs outside the CRCESU circuit
/// entirely, so **nothing here can be verified programmatically** — the chef confirms,
/// because the chef is who receives both the issuer's notification and the money.
///
/// Deliberately thin for paper CESU: no titre count, no millesime, no deposit date, no
/// reimbursed amount. The platform provides the payment method, the invoice and the
/// commission debit; depositing, validating and cashing paper titres is the chef's own
/// responsibility (CGU/CGV). Electronic CESU makes that moot anyway — the issuer's
/// portal refuses to spend an expired titre.
model CesuSettlement {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String               @unique(map: "uq_cesu_settlements_payment_id") @map("payment_id") @db.Uuid
  medium            CesuMedium
  /// Null for paper: the issuer only matters for the e-CESU support conversation.
  issuer            CesuIssuer?
  status            CesuSettlementStatus @default(declared)
  /// Free-text reference the client copies from their issuer's confirmation. A
  /// supporting document, **never a proof** — no issuer reference is verifiable.
  clientProofRef    String?              @map("client_proof_ref") @db.VarChar(255)
  confirmedAt       DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  rejectionReason   String?              @map("rejection_reason")
  /// Who settled it. An admin force-settle writes a tax-credit line in a chef's name,
  /// so it is traced rather than indistinguishable from the chef's own confirmation.
  confirmedByUserId String?              @map("confirmed_by_user_id") @db.Uuid
  adminOverride     Boolean              @default(false) @map("admin_override")
  adminProofRef     String?              @map("admin_proof_ref") @db.VarChar(255)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "fk_cesu_settlements_payment_id")
  confirmedBy       User?                @relation("CesuSettlementConfirmedBy", fields: [confirmedByUserId], references: [id], map: "fk_cesu_settlements_confirmed_by_user_id")

  @@index([status], map: "ix_cesu_settlements_status")
  @@map("cesu_settlements")
}

/// **Facture B** — the commission invoice the platform issues to the chef, and the legal
/// basis of the SEPA debit. The invoice always precedes the debit: a debit collects
/// against a receivable, it does not create one.
///
/// `paymentMethod` mirrors facture A's field and is what says whether the commission was
/// already withheld (`cb`, via `application_fee_amount`) or is still to be collected
/// (`cesu`, via direct debit).
///
/// `pdfObjectKey` / `s3ArchivedAt` are laid down empty on purpose: rendering and the
/// 10-year S3 retention belong to the invoicing workstream, which fills them without a
/// destructive migration. `LF-COM-<year>-NNNN` is **the** numbering scheme for facture B —
/// do not invent a second one.
model CommissionInvoice {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId    String                     @map("chef_profile_id") @db.Uuid
  invoiceNumber    String                     @unique(map: "uq_commission_invoices_invoice_number") @map("invoice_number") @db.VarChar(32)
  issuedAt         DateTime                   @default(now()) @map("issued_at") @db.Timestamptz(6)
  amountHtCents    Int                        @map("amount_ht_cents")
  amountVatCents   Int                        @map("amount_vat_cents")
  amountTtcCents   Int                        @map("amount_ttc_cents")
  /// Copied from the billed commissions and frozen, exactly like on `Commission`.
  rateBps          Int                        @map("rate_bps")
  vatRateBps       Int                        @map("vat_rate_bps")
  paymentMethod    PaymentMethod              @map("payment_method")
  collectionMethod CommissionCollectionMethod @map("collection_method")
  status           CommissionInvoiceStatus    @default(issued)
  /// Set only for a `monthly_batch` invoice; null when one payment produced one invoice.
  periodStart      DateTime?                  @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime?                  @map("period_end") @db.Timestamptz(6)
  pdfObjectKey     String?                    @map("pdf_object_key") @db.VarChar(512)
  s3ArchivedAt     DateTime?                  @map("s3_archived_at") @db.Timestamptz(6)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chefProfile      ChefProfile                @relation(fields: [chefProfileId], references: [id], onDelete: Restrict, map: "fk_commission_invoices_chef_profile_id")
  commissions      Commission[]
  debits           CommissionDebit[]

  @@index([chefProfileId], map: "ix_commission_invoices_chef_profile_id")
  @@index([status], map: "ix_commission_invoices_status")
  @@map("commission_invoices")
}

/// One **collection attempt** against a facture B. N debits for 1 invoice: a failed
/// debit does not cancel the receivable, so a retry reuses the invoice number instead of
/// burning a new one and leaving a hole in the sequence.
///
/// `clawbackWindowEndsAt` is `settledAt + 56 days`: under the SEPA **CORE** scheme — the
/// only one Stripe supports — the debtor can dispute "no questions asked" for 8 weeks and
/// the bank honours it automatically. A settled commission is therefore never final
/// before that date.
model CommissionDebit {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commissionInvoiceId   String                @map("commission_invoice_id") @db.Uuid
  /// Null between the row being created and the Stripe call returning. The row is
  /// written first on purpose: its id seeds the idempotency key, so a crash mid-call is
  /// repaired by replaying the identical request rather than by charging twice.
  stripePaymentIntentId String?               @unique(map: "uq_commission_debits_stripe_payment_intent_id") @map("stripe_payment_intent_id") @db.VarChar(128)
  amountTtcCents        Int                   @map("amount_ttc_cents")
  status                CommissionDebitStatus @default(pending)
  attemptNumber         Int                   @default(1) @map("attempt_number")
  failureReason         String?               @map("failure_reason")
  initiatedAt           DateTime?             @map("initiated_at") @db.Timestamptz(6)
  settledAt             DateTime?             @map("settled_at") @db.Timestamptz(6)
  clawbackWindowEndsAt  DateTime?             @map("clawback_window_ends_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  commissionInvoice     CommissionInvoice     @relation(fields: [commissionInvoiceId], references: [id], onDelete: Restrict, map: "fk_commission_debits_commission_invoice_id")

  @@index([commissionInvoiceId], map: "ix_commission_debits_commission_invoice_id")
  @@index([status], map: "ix_commission_debits_status")
  @@map("commission_debits")
}

/// Webhook de-duplication ledger.
///
/// The guard tests **`processedAt`**, not the mere existence of the row: a handler that
/// throws on the first delivery has already inserted its row, and an existence check
/// would then read Stripe's retry as a duplicate and drop the event for good.
model StripeEventLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String    @unique(map: "uq_stripe_event_logs_event_id") @map("event_id") @db.VarChar(128)
  type        String    @db.VarChar(128)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stripe_event_logs")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model typeorm_migrations {
  id        Int    @id(map: "PK_bb2f075707dd300ba86d0208923") @default(autoincrement())
  timestamp BigInt
  name      String @db.VarChar
}

