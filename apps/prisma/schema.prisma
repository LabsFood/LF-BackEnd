generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId              String                    @unique(map: "uq_users_clerk_user_id") @map("clerk_user_id") @db.VarChar(128)
  email                    String                    @unique(map: "uq_users_email") @db.VarChar(320)
  fullName                 String?                   @map("full_name") @db.VarChar(255)
  role                     UserRole                  @default(client)
  phone                    String?                   @db.VarChar(32)
  /// Profile photo on Cloudflare R2, for every role. Set only by the photo upload,
  /// which checks the file.
  avatarUrl                String?                   @map("avatar_url") @db.VarChar(512)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Set when Clerk deleted the account but bookings keep the row: its personal
  /// data is blanked (`UsersService.deleteByClerkId`).
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  bookingsAsClient         Booking[]                 @relation("BookingClient")
  reschedulesProposed      BookingReschedule[]       @relation("BookingRescheduleProposer")
  chefProfile              ChefProfile?
  clientProfile            ClientProfile?
  quotes                   Quote[]                   @relation("QuoteClient")
  applicationsDecided      ChefApplication[]         @relation("ChefApplicationDecidedBy")
  documentsDecided         ChefDocument[]            @relation("ChefDocumentDecidedBy")
  auditEntries             AuditLog[]                @relation("AuditLogActor")
  mealsAuthored            Meal[]                    @relation("MealAuthor")
  menusAuthored            Menu[]                    @relation("MenuAuthor")
  conversationsAsClient    Conversation[]            @relation("ConversationClient")
  supportConversation      Conversation?             @relation("ConversationSupportUser")
  conversationMemberships  ConversationParticipant[]
  messagesSent             Message[]                 @relation("MessageSender")
  messageAttachments       MessageAttachment[]       @relation("MessageAttachmentUploader")
  contactReplies           ContactMessageReply[]     @relation("ContactReplySender")
  cesuSettlementsConfirmed CesuSettlement[]          @relation("CesuSettlementConfirmedBy")
  urssafLinks              UrssafLink[]              @relation("UrssafLinkClient")

  @@map("users")
}

model ChefProfile {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                      @unique(map: "uq_chef_profiles_user_id") @map("user_id") @db.Uuid
  displayName            String                      @map("display_name") @db.VarChar(255)
  bio                    String?
  city                   String?                     @db.VarChar(120)
  serviceRadiusKm        Int                         @default(10) @map("service_radius_km")
  /// Languages spoken with clients: codes from `GET /referentials/languages`.
  languages              String[]                    @default([])
  isActive               Boolean                     @default(false) @map("is_active")
  isVerified             Boolean                     @default(false) @map("is_verified")
  cronofyProfileId       String?                     @map("cronofy_profile_id") @db.VarChar(128)
  stripeAccountId        String?                     @map("stripe_account_id") @db.VarChar(128)
  /// Zones the chef covers, copied from the approved candidature. Shape matches
  /// `chef_applications.intervention_zones`.
  interventionZones      Json                        @default("[]") @map("intervention_zones")
  /// Service-a-la-personne declaration route, carried over from the candidature.
  sapPath                SapPath?                    @map("sap_path")
  sapDeclarationNumber   String?                     @map("sap_declaration_number") @db.VarChar(16)
  /// Set by the daily dossier job when a blocking document expires, cleared when a
  /// valid one is deposited. Distinguishes an automatic suspension from an admin
  /// deactivation: only an automatic one may be undone automatically.
  autoSuspendedAt        DateTime?                   @map("auto_suspended_at") @db.Timestamptz(6)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  availabilitySlots      AvailabilitySlot[]
  bookings               Booking[]                   @relation("BookingChefProfile")
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chef_profiles_user_id")
  serviceOffers          ServiceOffer[]
  documents              ChefDocument[]
  application            ChefApplication?            @relation("ChefProfileApplication")
  dishes                 Meal[]                      @relation("MealOwner")
  menus                  Menu[]                      @relation("MenuOwner")
  dishesOffered          Meal[]                      @relation("MealOffer")
  menusOffered           Menu[]                      @relation("MenuOffer")
  showcaseWeeks          ChefShowcaseWeek[]
  conversations          Conversation[]              @relation("ConversationChefProfile")
  quoteOffers            QuoteOffer[]                @relation("QuoteOfferChefProfile")
  /// Mirrored 1:1 from the Stripe `account.updated` webhook: never set by hand.
  stripeChargesEnabled   Boolean                     @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled   Boolean                     @default(false) @map("stripe_payouts_enabled")
  stripeDetailsSubmitted Boolean                     @default(false) @map("stripe_details_submitted")
  sapProfile             SapProfile?
  sepaMandate            SepaMandate?
  commissions            Commission[]
  commissionInvoices     CommissionInvoice[]
  urssafLinks            UrssafLink[]
  workingHours           ChefWorkingHour[]
  availabilityExceptions ChefAvailabilityException[]
  timeBlocks             ChefTimeBlock[]
  calendarFeed           ChefCalendarFeed?

  @@map("chef_profiles")
}

model ServiceOffer {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId    String      @map("provider_id") @db.Uuid
  name             String      @db.VarChar(160)
  description      String?
  durationMinutes  Int         @map("duration_minutes")
  priceCents       Int         @map("price_cents")
  currency         String      @default("EUR") @db.VarChar(3)
  isActive         Boolean     @default(true) @map("is_active")
  /// The chef does the shopping for this offer. Priced by `shoppingFeeCents`, which stays 0 otherwise.
  shoppingIncluded Boolean     @default(false) @map("shopping_included")
  shoppingFeeCents Int         @default(0) @map("shopping_fee_cents")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings         Booking[]
  chefProfile      ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_service_offers_chef_profile_id")

  @@index([chefProfileId], map: "ix_service_offers_chef_profile_id")
  @@map("service_offers")
}

model AvailabilitySlot {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId String      @map("provider_id") @db.Uuid
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(6)
  isBooked      Boolean     @default(false) @map("is_booked")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chefProfile   ChefProfile @relation(fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_availability_slots_chef_profile_id")

  @@index([chefProfileId], map: "ix_availability_slots_chef_profile_id")
  @@map("availability_slots")
}

model Booking {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference             String?             @unique(map: "bookings_reference_key") @db.VarChar(32)
  clientId              String              @map("client_id") @db.Uuid
  chefProfileId         String              @map("provider_id") @db.Uuid
  serviceOfferId        String              @map("service_offer_id") @db.Uuid
  formuleId             String?             @map("formule_id") @db.VarChar(32)
  bookingDate           DateTime?           @map("booking_date") @db.Date
  timeSlot              String?             @map("time_slot") @db.VarChar(64)
  persons               Int?
  startsAt              DateTime            @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime            @map("ends_at") @db.Timestamptz(6)
  status                BookingStatus       @default(pending)
  priceCents            Int                 @map("price_cents")
  amountTtc             Int?                @map("amount_ttc")
  amountAfterTax        Int?                @map("amount_after_tax")
  currency              String              @default("EUR") @db.VarChar(3)
  shoppingByClient      Boolean             @default(false) @map("shopping_by_client")
  /// The offer's shopping fee, shown apart; already counted in `amountTtc`. 0 when the
  /// offer has no shopping or the client does it.
  shoppingFeeCents      Int                 @default(0) @map("shopping_fee_cents")
  /// Extra dishes the client asked for, beyond what the offer covers ("Plats supp.").
  extraMeals            Int                 @default(0) @map("extra_meals")
  /// Adults beyond what the offer covers, and the extra dishes: each shown apart,
  /// already counted in `amountTtc`. Always 0 on a formule, which is a package.
  extraPersonsCents     Int                 @default(0) @map("extra_persons_cents")
  extraMealsCents       Int                 @default(0) @map("extra_meals_cents")
  addressLine           String?             @map("address_line") @db.VarChar(255)
  /// The city, apart, so the agenda can show it without the street.
  addressCity           String?             @map("address_city") @db.VarChar(120)
  addressPostalCode     String?             @map("address_postal_code") @db.VarChar(16)
  notes                 String?
  stripePaymentIntentId String?             @map("stripe_payment_intent_id") @db.VarChar(128)
  cronofyEventId        String?             @map("cronofy_event_id") @db.VarChar(128)
  /// When the batch cooker arrived on site: set by the first move to `cooking`.
  arrivedAt             DateTime?           @map("arrived_at") @db.Timestamptz(6)
  /// When the "24 h left to pay" reminder went out, so it goes out once.
  holdReminderSentAt    DateTime?           @map("hold_reminder_sent_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingMeals          BookingMeal[]
  client                User                @relation("BookingClient", fields: [clientId], references: [id], onUpdate: NoAction, map: "fk_bookings_client_id")
  chefProfile           ChefProfile         @relation("BookingChefProfile", fields: [chefProfileId], references: [id], onUpdate: NoAction, map: "fk_bookings_chef_profile_id")
  formule               Formule?            @relation(fields: [formuleId], references: [id], onUpdate: NoAction, map: "bookings_formule_id_fkey")
  shoppingList          ShoppingList?
  quote                 Quote?              @relation("QuoteBooking")
  serviceOffer          ServiceOffer        @relation(fields: [serviceOfferId], references: [id], onUpdate: NoAction, map: "fk_bookings_service_offer_id")
  payments              Payment[]
  photos                BookingPhoto[]
  reschedules           BookingReschedule[]

  @@index([clientId], map: "ix_bookings_client_id")
  @@index([chefProfileId], map: "ix_bookings_chef_profile_id")
  @@map("bookings")
}

model ClientProfile {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @unique(map: "client_profiles_user_id_key") @map("user_id") @db.Uuid
  dietaryPreferences String[]            @default([]) @map("dietary_preferences")
  allergies          String[]            @default([])
  dislikes           String[]            @default([])
  favorites          String[]            @default([])
  spiceLevel         Int?                @map("spice_level")
  householdAdults    Int                 @default(1) @map("household_adults")
  householdKids      Int                 @default(0) @map("household_kids")
  kitchenNotes       String?             @map("kitchen_notes")
  addressStreet      String?             @map("address_street") @db.VarChar(255)
  addressCity        String?             @map("address_city") @db.VarChar(120)
  addressPostalCode  String?             @map("address_postal_code") @db.VarChar(16)
  status             ClientProfileStatus @default(active)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_profiles_user_id_fkey")

  @@map("client_profiles")
}

/// A dish. `chefProfileId` is the owner: set for a chef's dish, null for Lab's Food
/// content. `createdByUserId` is the author, for attribution only: it never grants
/// a right, so an admin who writes a Lab's Food meal does not own it.
model Meal {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chefProfileId          String?             @map("chef_profile_id") @db.Uuid
  createdByUserId        String?             @map("created_by_user_id") @db.Uuid
  /// Lab's Food content prepared for one chef: only they see it, and it becomes
  /// theirs only when they accept (PRD). Never set together with an owner.
  offeredToChefProfileId String?             @map("offered_to_chef_profile_id") @db.Uuid
  /// The Lab's Food suggestion this dish was adopted from, and that suggestion's
  /// `updatedAt` at adoption: the version the chef consented to copy (§6).
  sourceMealId           String?             @map("source_meal_id") @db.Uuid
  sourceVersion          DateTime?           @map("source_version") @db.Timestamptz(6)
  /// Set when the suggestion's allergens, diets or country changed after adoption.
  sourceChangedAt        DateTime?           @map("source_changed_at") @db.Timestamptz(6)
  name                   String              @db.VarChar(255)
  description            String?
  imageUrl               String?             @map("image_url") @db.VarChar(512)
  continent              MealContinent?
  country                String?             @db.VarChar(120)
  portions               Int                 @default(4)
  prepTime               Int                 @map("prep_time")
  dietaryTags            String[]            @default([]) @map("dietary_tags")
  allergens              String[]            @default([])
  /// "None of the 14 regulated allergens", said explicitly. An empty `allergens`
  /// list alone cannot be told apart from "not filled in" (FLOW-02 §3.3). A CHECK
  /// in the migration forbids it next to a listed allergen.
  allergensNone          Boolean             @default(false) @map("allergens_none")
  /// Free-text values outside the reference lists (the "Autre" button).
  customDiets            String[]            @default([]) @map("custom_diets")
  customAllergens        String[]            @default([]) @map("custom_allergens")
  category               String?             @db.VarChar(24)
  cookTime               Int?                @map("cook_time")
  calories               Int?
  difficulty             MealDifficulty?
  ingredients            Json                @default("[]")
  steps                  String[]            @default([])
  /// The recipe's version: +1 on every change to ingredients, steps, reheating,
  /// storage or portions. A booking pins the version it was cooked from (§9.2).
  recipeVersion          Int                 @default(1) @map("recipe_version")
  reheating              Json?
  storage                Json?
  isFeatured             Boolean             @default(false) @map("is_featured")
  status                 MealStatus          @default(draft)
  /// Last time it was published. Orders the admin review queue.
  publishedAt            DateTime?           @map("published_at") @db.Timestamptz(6)
  /// Moderation after the fact (§4): when an admin last looked, why it now waits
  /// in the review queue (null: it does not), and why it was taken down.
  reviewedAt             DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  reviewPendingSince     DateTime?           @map("review_pending_since") @db.Timestamptz(6)
  reviewReason           String?             @map("review_reason") @db.VarChar(40)
  moderationReason       String?             @map("moderation_reason")
  moderationReasonCode   String?             @map("moderation_reason_code") @db.VarChar(40)
  moderatedAt            DateTime?           @map("moderated_at") @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingMeals           BookingMeal[]
  menuWeeks              MenuWeekMeal[]
  menus                  MenuDish[]
  recipeVersions         MealRecipeVersion[]
  copies                 Meal[]              @relation("MealSource")
  source                 Meal?               @relation("MealSource", fields: [sourceMealId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_meals_source_meal_id")
  offeredTo              ChefProfile?        @relation("MealOffer", fields: [offeredToChefProfileId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_meals_offered_to_chef_profile_id")
  // Cascade, not SetNull: an ownerless chef dish would become a public Lab's Food
  // suggestion. booking_meals is RESTRICT, so a booked dish still blocks the delete.
  chefProfile            ChefProfile?        @relation("MealOwner", fields: [chefProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_meals_chef_profile_id")
  createdBy              User?               @relation("MealAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_meals_created_by_user_id")

  /// Adoption is idempotent per (chef, suggestion). NULLs never collide, so a
  /// chef's own dishes and Lab's Food rows are unaffected.
  @@unique([chefProfileId, sourceMealId], map: "uq_meals_chef_profile_source")
  @@index([chefProfileId], map: "ix_meals_chef_profile_id")
  @@index([createdByUserId], map: "ix_meals_created_by_user_id")
  @@index([offeredToChefProfileId], map: "ix_meals_offered_to_chef_profile_id")
  @@index([sourceMealId], map: "ix_meals_source_meal_id")
  @@index([reviewPendingSince], map: "ix_meals_review_pending_since")
  @@map("meals")
}

model MenuWeek {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekNumber  Int            @map("week_number")
  year        Int
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  meals       MenuWeekMeal[]

  @@unique([year, weekNumber], map: "uq_menu_weeks_year_week")
  @@map("menu_weeks")
}

model MenuWeekMeal {
  menuWeekId String   @map("menu_week_id") @db.Uuid
  mealId     String   @map("meal_id") @db.Uuid
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "menu_week_meals_meal_id_fkey")
  menuWeek   MenuWeek @relation(fields: [menuWeekId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "menu_week_meals_menu_week_id_fkey")

  @@id([menuWeekId, mealId])
  @@map("menu_week_meals")
}

model Formule {
  id            String    @id @db.VarChar(32)
  name          String    @db.VarChar(120)
  priceTtc      Int       @map("price_ttc")
  priceAfterTax Int       @map("price_after_tax")
  duration      String    @db.VarChar(64)
  mealsCount    Int       @map("meals_count")
  persons       String    @db.VarChar(64)
  features      String[]  @default([])
  popular       Boolean   @default(false)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings      Booking[]

  @@map("formules")
}

model BookingMeal {
  bookingId     String             @map("booking_id") @db.Uuid
  mealId        String             @map("meal_id") @db.Uuid
  portions      Int                @default(4)
  /// The recipe version this prestation cooks from, pinned once and kept (§9.2).
  recipeVersion Int?               @map("recipe_version")
  booking       Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "booking_meals_booking_id_fkey")
  meal          Meal               @relation(fields: [mealId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "booking_meals_meal_id_fkey")
  /// The kept version this prestation cooks from; it can never be lost while pinned.
  recipe        MealRecipeVersion? @relation(fields: [mealId, recipeVersion], references: [mealId, version], onDelete: Restrict, onUpdate: NoAction, map: "fk_booking_meals_recipe_version")

  @@id([bookingId, mealId])
  @@index([mealId], map: "ix_booking_meals_meal_id")
  @@map("booking_meals")
}

model ShoppingList {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String         @unique(map: "shopping_lists_booking_id_key") @map("booking_id") @db.Uuid
  generatedAt DateTime       @default(now()) @map("generated_at") @db.Timestamptz(6)
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shopping_lists_booking_id_fkey")
  items       ShoppingItem[]

  @@map("shopping_lists")
}

model ShoppingItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shoppingListId String       @map("shopping_list_id") @db.Uuid
  aisle          String       @db.VarChar(120)
  name           String       @db.VarChar(255)
  quantity       String       @db.VarChar(64)
  qty            Float?
  unit           String?      @db.VarChar(32)
  /// A line the batch cooker changed or added (`edited`), or struck out (`removed`).
  /// These survive a recalculation; the others are recomputed from the recipes.
  edited         Boolean      @default(false)
  removed        Boolean      @default(false)
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shopping_items_shopping_list_id_fkey")

  @@index([shoppingListId], map: "ix_shopping_items_list_id")
  @@map("shopping_items")
}

model Quote {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference           String       @unique(map: "quotes_reference_key") @db.VarChar(32)
  clientId            String       @map("client_id") @db.Uuid
  title               String       @db.VarChar(255)
  persons             Int
  mealsCount          Int          @map("meals_count")
  cuisine             String       @db.VarChar(120)
  diet                String[]     @default([])
  brief               String
  status              QuoteStatus  @default(submitted)
  assignedChefUserId  String?      @map("assigned_chef_user_id") @db.Uuid
  quoteAmountTtc      Int?         @map("quote_amount_ttc")
  quoteAmountAfterTax Int?         @map("quote_amount_after_tax")
  quoteNote           String?      @map("quote_note")
  /// What the request is for, in the client's words ("Anniversaire", "Repas de famille").
  occasion            String?      @db.VarChar(160)
  /// The day the client wants the prestation. Null on requests older than the offer flow.
  desiredDate         DateTime?    @map("desired_date") @db.Date
  /// `morning`, `afternoon` or `evening`: see `TIME_SLOTS`.
  timeSlot            String?      @map("time_slot") @db.VarChar(16)
  addressLine         String?      @map("address_line") @db.VarChar(255)
  addressCity         String?      @map("address_city") @db.VarChar(120)
  addressPostalCode   String?      @map("address_postal_code") @db.VarChar(16)
  allergies           String[]     @default([])
  /// What the client is ready to spend, as a hint for the batch cooker. Cents.
  budgetCents         Int?         @map("budget_cents")
  /// Why the batch cooker turned the request down, read by the admin who reassigns it.
  chefDeclineReason   String?      @map("chef_decline_reason")
  chefDeclinedAt      DateTime?    @map("chef_declined_at") @db.Timestamptz(6)
  /// The prestation an accepted offer became. Set once, by the acceptance.
  bookingId           String?      @unique(map: "uq_quotes_booking_id") @map("booking_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client              User         @relation("QuoteClient", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "quotes_client_id_fkey")
