/// Order matches the stored Postgres labels: pending -> succeeded (Stripe settled) ->
/// paid (invoiceable), with failed / refunded / partially_refunded as exit states.
enum PaymentStatus {
  pending
  succeeded
  /// Reserved for invoicing — **no code path sets this today**. A CB payment stops at
  /// `succeeded`, which is what the fiscal attestation totals count. Kept because the
  /// label predates this branch (`20250522130000_spec_domain`) and Prisma throws on an
  /// enum value it does not know, so dropping it here would break reads of any legacy
  /// row. Give it a writer or retire it deliberately — do not treat it as a synonym
  /// for `succeeded`.
  paid
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum CommissionCollectionMethod {
  stripe_application_fee
  sepa_direct_debit

  @@map("commission_collection_method")
}

/// `pending` -> `invoiced` (billed on a facture B) -> `processing` (a SEPA debit is in
/// flight) -> `collected`. `reversed` is the SEPA CORE clawback: the chef disputed within
/// the 8-week window, the bank honoured it, and the receivable is open again.
/// A card commission skips straight to `collected` — Stripe withholds it at charge time.
enum CommissionStatus {
  pending
  invoiced
  processing
  collected
  failed
  reversed

  @@map("commission_status")
}

