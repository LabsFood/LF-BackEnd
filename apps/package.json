{
  "name": "lf-api-nestjs",
  "version": "2.4.0",
  "private": true,
  "description": "Labs Food NestJS + Fastify booking service (primary API).",
  "scripts": {
    "build": "prisma generate && nest build",
    "postinstall": "prisma generate",
    "prepare": "cd .. && git config core.hooksPath .husky || exit 0",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:resolve": "prisma migrate resolve",
    "db:seed:demo": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-demo.ts",
    "db:unseed:demo": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/unseed-demo.ts",
    "db:sync:clerk": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/sync-users-to-clerk.ts",
    "db:sync:clerk:dry": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/sync-users-to-clerk.ts --dry-run",
    "db:backfill:clerk": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/sync-clerk-to-db.ts",
    "db:backfill:clerk:dry": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/sync-clerk-to-db.ts --dry-run",
    "db:recipes:reprise": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/recipes-reprise.ts",
    "db:recipes:reprise:dry": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/recipes-reprise.ts --dry-run",
    "ai:bench:recipes": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/recipe-import-bench.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "Labs Food Developers Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@clerk/backend": "^3.4.14",
    "@fastify/helmet": "^12.0.1",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/platform-ws": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.1.5",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "^11.11.0",
    "@supabase/supabase-js": "^2.106.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "joi": "^17.13.9",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "fastify": "^5.12.7",
    "@nestjs/swagger": {
      "js-yaml": "^5.4.1"
    },
    "@nestjs/cli": {
      "glob": "^14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@prisma/config": {
      "effect": "^3.22.1"
    }
  }
}
