# ------------------------------------------------------------------------------
# LF BackEnd — copy to .env and fill values. Never commit .env.
# ------------------------------------------------------------------------------

# App
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# Railway injects PORT; the API uses API_PORT, then PORT, then 8000 (see apps/src/config/config.loader.ts)

# Supabase Postgres (see docs/database-connection.md)
# Store at repo root (.env). Optional override: .env.local (same keys, never commit).
# Works when running from repo root or `cd apps` — both Nest and `npm run migration:*` load these files.
#
# Local: one direct URL for app + migrations
# SUPABASE_DB_URL=postgresql://lf:lf@localhost:5432/lf_backend
# SUPABASE_DB_MIGRATION_URL=postgresql://lf:lf@localhost:5432/lf_backend
#
# Cloud runtime — Transaction pooler (6543), no surrounding quotes:
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Cloud migrations only — direct session (5432). Omit locally (CLI falls back to SUPABASE_DB_URL).
# SUPABASE_DB_MIGRATION_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Deprecated: migration fallback only; prefer SUPABASE_DB_MIGRATION_URL
# DATABASE_URL=

# Redis (cache, queues) — not implemented yet; uncomment when enabling RedisModule
# REDIS_URL=redis://localhost:6379/0

# Clerk — https://dashboard.clerk.com/~/api-keys
# Backend: secret key only (publishable key is for frontends).
# Local dev: sk_test_placeholder skips JWKS verification (see AGENTS.md).
# Production: sk_live_… from Dashboard; API verifies session JWTs via @clerk/backend.
CLERK_SECRET_KEY=
# Clerk Dashboard → Webhooks → POST https://<api-host>/webhooks/clerk
# Events: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe Dashboard → Webhooks → POST https://<api-host>/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded,
#         account.updated, setup_intent.succeeded
# Local: `stripe listen --forward-to localhost:8000/webhooks/stripe` prints a whsec_… secret
# that covers BOTH scopes below, so STRIPE_CONNECT_WEBHOOK_SECRET can stay empty in dev.
STRIPE_WEBHOOK_SECRET=
# Deployed environments need TWO Dashboard endpoints on the same /webhooks/stripe URL,
# each with its own signing secret:
#   "Your account"       -> payment_intent.succeeded, payment_intent.payment_failed,
#                           charge.refunded, setup_intent.succeeded   -> STRIPE_WEBHOOK_SECRET
#   "Connected accounts" -> account.updated                    -> STRIPE_CONNECT_WEBHOOK_SECRET
# Without the second one, account.updated is rejected and chefs stay chargesEnabled=false.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Payments — platform commission and Stripe Connect onboarding redirects
# Commission is expressed in basis points: 1500 = 15 % HT, 2000 = 20 % VAT.
# 15 % is a PLACEHOLDER — replace with the negotiated rate before production.
PAYMENTS_COMMISSION_RATE_BPS=1500
PAYMENTS_COMMISSION_VAT_RATE_BPS=2000
# Where Stripe returns the chef after Connect onboarding (batchcooking-web, port 3005 locally)
STRIPE_CONNECT_REFRESH_URL=http://localhost:3005/chef/onboarding/stripe/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3005/chef/onboarding/stripe/return

# Cronofy — calendar / availability — https://docs.cronofy.com/
CRONOFY_CLIENT_ID=
CRONOFY_CLIENT_SECRET=
# e.g. us, de — see Cronofy data center docs
CRONOFY_DATA_CENTER=us

# Stream — chat — https://getstream.io/
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_APP_ID=

# Brevo (ex-Sendinblue) — transactional email — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Optional: explicit sender used by the API
BREVO_SENDER_EMAIL=noreply@labsfood.com
BREVO_SENDER_NAME=Labs Food

# Google Maps — https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# AWS S3 — provider media / documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=

# Supabase project API — optional CMS asset storage (server uses service role; never expose in clients)
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Storage bucket for F19 concept page images (create in Supabase Storage when enabled)
SUPABASE_CMS_ASSETS_BUCKET=cms-assets

# CORS — the product frontends are already allowlisted in
# apps/src/config/allowed-origins.ts (labsfood.fr, batchcooking.labsfood.fr,
# localhost:3007 / :3005 / :3000 outside production). Use this variable only for
# extra origins: preview deploys, ngrok/cloudflared tunnels, staging.
# Comma-separated, exact scheme + host + port, no wildcards.
# CORS_ORIGINS=https://preview-abc.vercel.app,https://xyz.ngrok-free.app

# ------------------------------------------------------------------------------
# Production (Railway dashboard — do not commit real values)
# ------------------------------------------------------------------------------
# NODE_ENV=production
# ENVIRONMENT=production
# DEBUG=false
# API_HOST=0.0.0.0
# SUPABASE_DB_URL=<transaction pooler :6543 — see docs/database-connection.md>
# SUPABASE_DB_MIGRATION_URL=<session pooler or direct :5432 — migrations only; see docs/database-connection.md>
# CLERK_SECRET_KEY=<sk_live_…>
# CORS_ORIGINS=https://your-app.example,https://your-admin.example
# Public API (Railway → Networking — not *.railway.internal):
#   Swagger: https://<public-domain>/docs
#   Health:  https://<public-domain>/health
#   Ready:   https://<public-domain>/ready
# Full checklist: docs/deploy/railway.md
