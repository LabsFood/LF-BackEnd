# ------------------------------------------------------------------------------
# LF BackEnd — copy to .env and fill values. Never commit .env.
# ------------------------------------------------------------------------------

# App
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL — used by NestJS + TypeORM
DATABASE_URL=postgresql://lf:lf@localhost:5432/lf_backend

# Redis (cache, queues)
REDIS_URL=redis://localhost:6379/0

# Clerk — https://dashboard.clerk.com/
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cronofy — calendar / availability — https://docs.cronofy.com/
CRONOFY_CLIENT_ID=
CRONOFY_CLIENT_SECRET=
# e.g. us, de — see Cronofy data center docs
CRONOFY_DATA_CENTER=us

# Stream — chat — https://getstream.io/
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_APP_ID=

# Brevo (ex-Sendinblue) — transactional email — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Optional: explicit sender used by the API
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Labs Food

# Google Maps — https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# AWS S3 — provider media / documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=

# CORS (comma-separated origins for local Next.js / RN dev, if applicable)
CORS_ORIGINS=http://localhost:3000
