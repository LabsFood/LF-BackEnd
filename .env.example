# ------------------------------------------------------------------------------
# LF BackEnd — copy to .env and fill values. Never commit .env.
# ------------------------------------------------------------------------------

# App
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# Railway injects PORT; the API uses API_PORT, then PORT, then 8000 (see apps/src/config/config.loader.ts)

# Supabase Postgres (see docs/database-connection.md)
# Store at repo root (.env). Optional override: .env.local (same keys, never commit).
# Works when running from repo root or `cd apps` — both Nest and `npm run db:*` load these files.
#
# Local: one direct URL for app + migrations
# SUPABASE_DB_URL=postgresql://lf:lf@localhost:5432/lf_backend
# SUPABASE_DB_MIGRATION_URL=postgresql://lf:lf@localhost:5432/lf_backend
#
# Cloud runtime — Transaction pooler (6543), no surrounding quotes:
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Cloud migrations only — direct session (5432). Omit locally (CLI falls back to SUPABASE_DB_URL).
# SUPABASE_DB_MIGRATION_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Deprecated: migration fallback only; prefer SUPABASE_DB_MIGRATION_URL
# DATABASE_URL=

# Redis — messaging rate limit and realtime fan-out between API instances.
# Optional: left empty, both stay inside the process, which suits one instance and
# local development. Required as soon as the API runs on more than one instance.
REDIS_URL=

# Clerk — https://dashboard.clerk.com/~/api-keys
# Backend: secret key only (publishable key is for frontends).
# Local dev: sk_test_placeholder skips JWKS verification (see AGENTS.md).
# Production: sk_live_… from Dashboard; API verifies session JWTs via @clerk/backend.
CLERK_SECRET_KEY=
# Clerk Dashboard → Webhooks → POST https://<api-host>/webhooks/clerk
# Events: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe Dashboard → Webhooks → POST https://<api-host>/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.processing, payment_intent.payment_failed,
#         charge.refunded, charge.dispute.created, charge.dispute.closed,
#         account.updated, setup_intent.succeeded, mandate.updated
# Local: `stripe listen --forward-to localhost:8000/webhooks/stripe` prints a whsec_… secret
# that covers BOTH scopes below, so STRIPE_CONNECT_WEBHOOK_SECRET can stay empty in dev.
STRIPE_WEBHOOK_SECRET=
# Deployed environments need TWO Dashboard endpoints on the same /webhooks/stripe URL,
# each with its own signing secret:
#   "Your account"       -> payment_intent.succeeded, payment_intent.processing,
#                           payment_intent.payment_failed, charge.refunded,
#                           charge.dispute.created, charge.dispute.closed,
#                           setup_intent.succeeded, mandate.updated -> STRIPE_WEBHOOK_SECRET
#   "Connected accounts" -> account.updated                    -> STRIPE_CONNECT_WEBHOOK_SECRET
# Without the second one, account.updated is rejected and chefs stay chargesEnabled=false.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Payments — platform commission and Stripe Connect onboarding redirects
# Commission is expressed in basis points: 1500 = the contracted 15 % HT,
# 2000 = 20 % VAT charged on that commission.
# The rate is a fallback: the one an admin saves from the console wins
# (PATCH /admin/settings/commission), and a prestation born from an accepted offer
# keeps the commission of that offer, whatever the rate has become.
PAYMENTS_COMMISSION_RATE_BPS=1500
PAYMENTS_COMMISSION_VAT_RATE_BPS=2000
# Commission collected by SEPA direct debit (CESU today, avance immédiate later): the
# commission on those flows cannot be withheld at charge time, so the platform issues a
# commission invoice (facture B) and debits the chef against it.
#   on_payment    (default) one invoice + one debit per CESU payment, at confirmation
#   monthly_batch commissions stay `pending` until POST /admin/commission-invoices/run-due
#                 groups them per chef and per period
PAYMENTS_COMMISSION_DEBIT_TRIGGER=on_payment
# Debit attempts per invoice before an admin has to retry by hand. An exhausted invoice
# blocks new bookings and payments for that chef until it is settled or written off.
PAYMENTS_COMMISSION_DEBIT_MAX_ATTEMPTS=3
# Numbering of facture B: <prefix>-<year>-NNNN. The 8-week SEPA CORE clawback window is
# NOT configurable — it is the scheme's rule, not ours.
PAYMENTS_COMMISSION_INVOICE_PREFIX=LF-COM
# Numbering of facture A, the client's invoice: <prefix>-<year>-NNNN.
PAYMENTS_INVOICE_PREFIX=LF-FAC
# Where Stripe returns the chef after Connect onboarding (batchcooking-web, port 3005 locally)
STRIPE_CONNECT_REFRESH_URL=http://localhost:3005/chef/onboarding/stripe/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3005/chef/onboarding/stripe/return
# URSSAF immediate advance. `disabled` (default): not offered. `simulated`: runs end to
# end, an admin answering in URSSAF's place (POST /admin/urssaf-links/{id}/decision,
# POST /admin/urssaf-payments/{id}/outcome). Refused at startup beside a live Stripe key
# (sk_live_…): it would mark real prestations as paid with no money behind them.
URSSAF_GATEWAY=disabled

# Brevo (ex-Sendinblue) — transactional email — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Optional: explicit sender used by the API
BREVO_SENDER_EMAIL=noreply@labsfood.com
BREVO_SENDER_NAME=Labs Food

# --- Chef onboarding emails (FLOW-01) -------------------------------------
# Brevo template ids. An unset id makes that one email a logged no-op instead of
# failing the operation behind it, so local development works without Brevo.
# Exception: wherever candidatures are accepted, BREVO_API_KEY and
# BREVO_TPL_APPLICATION_RECEIVED are required — that email carries the only
# sign-in link to the new account — and BREVO_TPL_SIGN_IN_LINK for the resend.
BREVO_TPL_APPLICATION_RECEIVED=
BREVO_TPL_APPLICATION_RECEIVED_ADMIN=
BREVO_TPL_DOCUMENT_REJECTED=
BREVO_TPL_CHANGES_REQUESTED=
BREVO_TPL_APPLICATION_REJECTED=
BREVO_TPL_APPLICATION_APPROVED=
BREVO_TPL_SIGN_IN_LINK=
BREVO_TPL_DOCUMENT_EXPIRING=
BREVO_TPL_CHEF_SUSPENDED=
# FLOW-02: a Lab's Food suggestion a chef adopted changed its allergens, diets or
# country; an admin took one of a chef's dishes or menus down, with the reason.
BREVO_TPL_SOURCE_CHANGED=
BREVO_TPL_CONTENT_SUSPENDED=
# Messaging: someone has messages they have not opened for 10 minutes. Params:
# firstName, senderName, unreadCount, conversationUrl. Unset: no email is sent.
BREVO_TPL_NEW_MESSAGE=
# Contact forms. The heads-up to the team (params: name, email, phone, subject,
# message, site, inboxUrl) and the team's answer to the sender (params: firstName,
# subject, reply, originalMessage). Without BREVO_TPL_CONTACT_REPLY an admin cannot
# answer from the console: the reply route answers 503 instead of pretending.
BREVO_TPL_CONTACT_RECEIVED_ADMIN=
BREVO_TPL_CONTACT_REPLY=
# Custom requests (sur-mesure). Each one unset: that email is skipped, the request
# goes on. To the batch cooker a request reaches (firstName, reference, title,
# persons, city, date, slot, requestsUrl); to CONTACT_NOTIFICATION_EMAIL when a
# request has no batch cooker (reference, title, clientName, declined,
# declineReason, requestsUrl); to the client when an offer arrives (firstName,
# chefName, title, price, priceAfterTaxCredit, validUntil, requestsUrl); to the
# batch cooker when it is refused (firstName, title, reason, requestsUrl); to both
# when it is accepted (firstName, forChef, counterpartName, reference, title, date,
# slot, address, persons, conditions, price, priceAfterTaxCredit, spaceUrl).
BREVO_TPL_QUOTE_REQUEST_CHEF=
BREVO_TPL_QUOTE_NEEDS_CHEF_ADMIN=
BREVO_TPL_QUOTE_OFFER_CLIENT=
BREVO_TPL_QUOTE_OFFER_DECLINED_CHEF=
# Lab's Food closed a request: to the client, and to its batch cooker (forChef).
BREVO_TPL_QUOTE_CLOSED=
BREVO_TPL_BOOKING_CONFIRMED=
# Bookings: an unpaid booking holds its slot 72 h; both sides are told at 48 h
# (reference, when, freedAt, amount, firstName; chefName + payUrl for the client,
# clientName + spaceUrl for the batch cooker).
BREVO_TPL_BOOKING_HOLD_REMINDER_CLIENT=
BREVO_TPL_BOOKING_HOLD_REMINDER_CHEF=
# Rescheduling a confirmed booking: the other side is asked (firstName, reference,
# fromWhen, toWhen, expiresAt, proposerName, answerUrl), then the proposer is told
# (firstName, reference, fromWhen, toWhen, accepted, answererName, spaceUrl).
BREVO_TPL_BOOKING_RESCHEDULE_PROPOSED=
BREVO_TPL_BOOKING_RESCHEDULE_ANSWERED=
# Who is told about a new contact message, and the Reply-To of the answers.
# Unset: no email, the message is in the admin inbox only.
CONTACT_NOTIFICATION_EMAIL=
# The admin console, for the link in that email.
ADMIN_SITE_URL=https://admin.labsfood.fr

# The batch cooking site, for the sign-in, dossier and dashboard links in the
# chef-onboarding emails. Must use the same Clerk instance as CLERK_SECRET_KEY:
# the sign-in link opens its /auth/login page with a Clerk ticket.
PUBLIC_SITE_URL=https://batchcooking.labsfood.fr
# Internal notification address for new candidatures. Unset = no admin email.
CHEF_APPLICATION_ADMIN_EMAIL=

# --- Logging ---------------------------------------------------------------
# LOG_JSON=true emits JSON lines (app logs and Fastify access logs) so Railway's
# log explorer can filter on fields. Defaults to true in production, false
# locally. Every response carries x-request-id, and the same id is stored on
# audit_log.request_id — that is how a Railway line joins a database row.
LOG_JSON=
# fatal | error | warn | info | debug | trace. Defaults: info in production, debug locally.
LOG_LEVEL=

# Google Maps — https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# Supabase project API — Storage for KYC documents and message attachments.
# Secret key (sb_secret_…), one per environment: Settings → API Keys → Secret keys.
# Server only, never in a client. The legacy service_role / anon JWTs are refused.
# https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Private bucket holding KYC documents (identity papers, registration, insurance).
# Must NOT allow public reads: every access goes through a short-lived signed URL.
SUPABASE_KYC_BUCKET=labsfood-kyc
# Private bucket holding the files sent in conversations. Create it in Supabase
# with no public read policy. Without Supabase, attachment routes answer 503.
SUPABASE_MESSAGING_BUCKET=labsfood-messages
# Private bucket holding the clients' invoices (facture A, PDF). Create it in Supabase
# with no public read policy. Without Supabase, the invoice is numbered but its PDF
# is not stored, and the download route answers 503.
SUPABASE_INVOICES_BUCKET=labsfood-invoices

# Cloudflare R2 bucket for dish and profile photos (public images: R2 has no egress fee).
# Leave empty to run without photos: those routes then answer 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public https address of the bucket: its custom domain or r2.dev URL.
R2_PUBLIC_BASE_URL=

# Supabase project API — optional CMS asset storage (same secret key as above; never expose in clients)
# https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Storage bucket for F19 concept page images (create in Supabase Storage when enabled)
SUPABASE_CMS_ASSETS_BUCKET=cms-assets

# CORS — the product frontends are already allowlisted in
# apps/src/config/allowed-origins.ts (labsfood.fr, batchcooking.labsfood.fr,
# localhost:3007 / :3005 / :3000 outside production). Use this variable only for
# extra origins: preview deploys, ngrok/cloudflared tunnels, staging.
# Comma-separated, exact scheme + host + port, no wildcards.
# CORS_ORIGINS=https://preview-abc.vercel.app,https://xyz.ngrok-free.app

# ------------------------------------------------------------------------------
# Production (Railway dashboard — do not commit real values)
# ------------------------------------------------------------------------------
# NODE_ENV=production
# ENVIRONMENT=production
# DEBUG=false
# API_HOST=0.0.0.0
# SUPABASE_DB_URL=<transaction pooler :6543 — see docs/database-connection.md>
# SUPABASE_DB_MIGRATION_URL=<session pooler or direct :5432 — migrations only; see docs/database-connection.md>
# CLERK_SECRET_KEY=<sk_live_…>
# CORS_ORIGINS=https://your-app.example,https://your-admin.example
# LOG_JSON=true              # structured logs for the Railway log explorer
# LOG_LEVEL=info
# SUPABASE_KYC_BUCKET=<private bucket, no public read policy>
# PUBLIC_SITE_URL=https://batchcooking.labsfood.fr
# CHEF_APPLICATION_ADMIN_EMAIL=<who gets notified of a new candidature>
# BREVO_TPL_*=<template ids — unset means that email is skipped, silently>
# Public API (Railway → Networking — not *.railway.internal):
#   Swagger: https://<public-domain>/docs
#   Health:  https://<public-domain>/health
#   Ready:   https://<public-domain>/ready
# Full checklist: docs/deploy/railway.md
