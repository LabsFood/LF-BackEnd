script:pre-request {
  // Local runs: an API started with CLERK_SECRET_KEY=sk_test_placeholder decodes
  // unsigned tokens, so one is built per role from its Clerk user id. Elsewhere,
  // paste real tokens into the secret variables clientToken, chefToken, adminToken.
  const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
  function b64url(text) {
    let out = '';
    for (let i = 0; i < text.length; i += 3) {
      const n =
        (text.charCodeAt(i) << 16) |
        ((text.charCodeAt(i + 1) || 0) << 8) |
        (text.charCodeAt(i + 2) || 0);
      out += B64[(n >> 18) & 63] + B64[(n >> 12) & 63];
      if (i + 1 < text.length) out += B64[(n >> 6) & 63];
      if (i + 2 < text.length) out += B64[n & 63];
    }
    return out;
  }
  if (bru.getEnvVar('unsignedTokens') === 'true') {
    for (const role of ['client', 'chef', 'admin']) {
      const sub = bru.getEnvVar(role + 'ClerkId');
      if (sub) {
        bru.setVar(
          role + 'Token',
          b64url('{"alg":"none","typ":"JWT"}') + '.' + b64url(JSON.stringify({ sub })) + '.unsigned',
        );
      }
    }
  }

  // Windows the requests use, from today (UTC midnight).
  const DAY = 86400000;
  const today = Math.floor(Date.now() / DAY) * DAY;
  const iso = (ms) => new Date(ms).toISOString();
  bru.setVar('weekFrom', iso(today));
  bru.setVar('weekTo', iso(today + 7 * DAY));
  bru.setVar('gridTo', iso(today + 42 * DAY));
  bru.setVar('tooLongTo', iso(today + 43 * DAY));
  bru.setVar('year', String(new Date(today).getUTCFullYear()));
  bru.setVar('in1Day', iso(today + DAY));
  bru.setVar('in4Days', iso(today + 4 * DAY));
  bru.setVar('in5Days', iso(today + 5 * DAY));
  bru.setVar('in12Days', iso(today + 12 * DAY));
  bru.setVar('in25Days', iso(today + 25 * DAY));
  bru.setVar('in20DaysDate', iso(today + 20 * DAY).slice(0, 10));
  bru.setVar('blockFrom', iso(today + 20 * DAY + 10 * 3600000));
  bru.setVar('blockTo', iso(today + 20 * DAY + 12 * 3600000));
}

docs {
  # LF-BackEnd

  Agenda, working hours, blocks, calendar feed, rescheduling, disputes, and the error
  contract (`code` and `requestId` on every refusal).

  ## Folders
  - **read-only**: GET requests only. Safe against any environment.
  - **scenario**: writes, in order. Use test accounts only. It:
    - replaces the test batch cooker's working hours, and restores them at the end
    - books, confirms, reschedules, disputes and cancels one booking
    - adds and removes a block
    - makes, rotates and turns off the batch cooker's calendar feed, which breaks any
      calendar app subscribed to it

  ## Accounts
  Three accounts, each a different person:
  - a client
  - an approved batch cooker with at least one active service offer (`chefProfileId`
    is their page id)
  - an admin

  ## Local
  1. Start the API with `CLERK_SECRET_KEY=sk_test_placeholder`. The API then decodes
     unsigned tokens.
  2. In the `local` environment, set `clientClerkId`, `chefClerkId`, `adminClerkId`
     (Clerk user ids such as `user_2abc…`) and `chefProfileId`.
  3. Run:
     ```
     cd bruno
     npx @usebruno/cli@4.2.1 run read-only -r --env local
     npx @usebruno/cli@4.2.1 run scenario -r --env local
     ```

  ## Develop
  Set `chefProfileId`, then paste three Clerk session tokens into the secret variables
  `clientToken`, `chefToken` and `adminToken`. Session tokens last 60 s: use a Clerk
  JWT template with a longer lifetime for a full run.
}
