meta {
  name: Admin - list all commission invoices
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/commission-invoices?status=issued
  body: none
  auth: none
}

params:query {
  status: issued
}

headers {
  Authorization: Bearer {{adminToken}}
}

script:post-response {
  if (Array.isArray(res.body) && res.body[0]?.id) {
    bru.setVar("commissionInvoiceId", res.body[0].id);
  }
}
