meta {
  name: Declare a prefinanced CESU payment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/payments/cesu
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{clerkToken}}
}

body:json {
  {
    "bookingId": "{{bookingId}}",
    "amountTtc": 6000,
    "medium": "ecesu",
    "issuer": "pluxee",
    "clientProofRef": "PLX-2026-0918-44711"
  }
}

script:post-response {
  if (res.body?.paymentId) {
    bru.setVar("cesuPaymentId", res.body.paymentId);
  }
}
