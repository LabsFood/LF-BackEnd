meta {
  name: Admin - send a price back to the client
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/admin/quotes/{{quoteId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "status": "quoted",
    "quoteAmountTtc": 45000,
    "quoteAmountAfterTax": 37500,
    "quoteNote": "Includes service staff and cleanup."
  }
}
