meta {
  name: Admin - create menu week
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/admin/menu-weeks
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "isoYear": 2026,
    "isoWeek": 30,
    "mealIds": ["{{mealId}}"]
  }
}

script:post-response {
  if (res.body?.id) {
    bru.setVar("menuWeekId", res.body.id);
  }
}
