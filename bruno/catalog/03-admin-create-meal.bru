meta {
  name: Admin - create meal
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/meals
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "name": "Poulet yassa",
    "description": "Marinated chicken, caramelized onions, rice.",
    "prepTime": 45,
    "dietaryTags": ["halal"],
    "allergens": []
  }
}

script:post-response {
  if (res.body?.id) {
    bru.setVar("mealId", res.body.id);
  }
}
