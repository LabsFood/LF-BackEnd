meta {
  name: Client books the first free time
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/me/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

body:json {
  {
    "serviceOfferId": "{{offerId}}",
    "startsAt": "{{slotA}}",
    "persons": 2,
    "addressLine": "12 rue des Lilas",
    "addressCity": "Paris",
    "addressPostalCode": "75011",
    "notes": "Bruno scenario: a test booking, cancelled at the end."
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("bookingId", res.getBody().id);
}

tests {
  test("201, pending, with its city", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("pending");
    expect(res.getBody().city).to.equal("Paris");
  });
}
