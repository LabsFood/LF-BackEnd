meta {
  name: The proposer cannot confirm their own
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/chef/bookings/{{bookingId}}/reschedule
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "decision": "accepted"
  }
}

tests {
  test("409", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("RESCHEDULE_OWN_PROPOSAL");
  });
}
