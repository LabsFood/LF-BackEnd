meta {
  name: The same block twice is one block
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/chef/agenda/blocks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "startsAt": "{{blockFrom}}",
    "endsAt": "{{blockTo}}",
    "reason": "Bruno test block"
  }
}

tests {
  const v = (name) => bru.getVar(name) ?? bru.getEnvVar(name);
  test("the first block back", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.equal(v("blockId"));
  });
}
