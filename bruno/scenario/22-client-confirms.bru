meta {
  name: Client confirms the new time
  type: http
  seq: 22
}

patch {
  url: {{baseUrl}}/me/bookings/{{bookingId}}/reschedule
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

body:json {
  {
    "decision": "accepted"
  }
}

tests {
  test("200, accepted", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("accepted");
  });
}
