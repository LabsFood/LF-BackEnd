meta {
  name: Overlapping ranges name the day
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/chef/availability
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "weekly": [
      {
        "weekday": 0,
        "startMinute": 540,
        "endMinute": 780
      },
      {
        "weekday": 0,
        "startMinute": 720,
        "endMinute": 900
      }
    ],
    "exceptions": []
  }
}

tests {
  test("422 SCHEDULE_OVERLAP naming Monday", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().code).to.equal("SCHEDULE_OVERLAP");
    expect(res.getBody().details.weekday).to.equal(0);
  });
}
