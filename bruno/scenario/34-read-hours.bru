meta {
  name: Read the hours before restoring them
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/chef/availability
  body: none
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("scheduleVersion", res.getBody().version);
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
