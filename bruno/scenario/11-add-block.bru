meta {
  name: Batch cooker blocks two hours
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/chef/agenda/blocks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "startsAt": "{{blockFrom}}",
    "endsAt": "{{blockTo}}",
    "reason": "Bruno test block"
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("blockId", res.getBody().id);
}

tests {
  test("201 with the block", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("string");
  });
}
