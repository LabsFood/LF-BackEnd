meta {
  name: Restore the batch cooker's working hours
  type: http
  seq: 35
}

put {
  url: {{baseUrl}}/chef/availability
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "restore": "set by the pre-request script"
  }
}

script:pre-request {
  const v = (name) => bru.getVar(name) ?? bru.getEnvVar(name);
  const saved = JSON.parse(v("originalSchedule"));
  req.setBody({ weekly: saved.weekly, exceptions: saved.exceptions, version: v("scheduleVersion") });
}

tests {
  const v = (name) => bru.getVar(name) ?? bru.getEnvVar(name);
  test("200, the hours as they were", function () {
    expect(res.getStatus()).to.equal(200);
    const saved = JSON.parse(v("originalSchedule"));
    expect(res.getBody().weekly).to.have.length(saved.weekly.length);
  });
}
