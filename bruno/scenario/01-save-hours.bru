meta {
  name: Save the batch cooker's working hours
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/chef/availability
  body: none
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setVar("originalSchedule", JSON.stringify({ weekly: body.weekly, exceptions: body.exceptions }));
    bru.setVar("scheduleVersion", body.version);
  }
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
