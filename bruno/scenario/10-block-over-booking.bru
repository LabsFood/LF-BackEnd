meta {
  name: A block over the booking is refused
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/chef/agenda/blocks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "startsAt": "{{slotA}}",
    "endsAt": "{{blockOverEnd}}"
  }
}

script:pre-request {
  const v = (name) => bru.getVar(name) ?? bru.getEnvVar(name);
  const start = new Date(v("slotA")).getTime();
  bru.setVar("blockOverEnd", new Date(start + 3600000).toISOString());
}

tests {
  test("409", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("BLOCK_OVERLAPS_BOOKING");
  });
}
