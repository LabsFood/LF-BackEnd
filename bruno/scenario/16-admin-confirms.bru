meta {
  name: Admin confirms the booking
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/admin/bookings/{{bookingId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "confirmed"
  }
}

tests {
  test("200, confirmed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("confirmed");
  });
}
