meta {
  name: A save from a stale tab is refused
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/chef/availability
  body: json
  auth: bearer
}

headers {
  x-request-id: bruno-stale-version
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "weekly": [
      {
        "weekday": 0,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 1,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 2,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 3,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 4,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 5,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 6,
        "startMinute": 480,
        "endMinute": 1200
      }
    ],
    "exceptions": [],
    "version": "stale-version"
  }
}

tests {
  test("409 SCHEDULE_CHANGED, with the request id sent", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("SCHEDULE_CHANGED");
    expect(res.getBody().requestId).to.equal("bruno-stale-version");
  });
}
