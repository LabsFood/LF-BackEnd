meta {
  name: Payment waits for the dispute
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/me/bookings/{{bookingId}}/cesu-proof/upload-url
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

body:json {
  {
    "contentType": "application/pdf",
    "sizeBytes": 1000
  }
}

tests {
  test("409", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("BOOKING_DISPUTED");
  });
}
