meta {
  name: Free times for the default offer
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/chefs/{{chefProfileId}}/availability?from={{in5Days}}&to={{in12Days}}
  body: none
  auth: none
}

params:query {
  from: {{in5Days}}
  to: {{in12Days}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    const first = body.slots[0];
    const nextDay = body.slots.find((s) => new Date(s).getTime() >= new Date(first).getTime() + 86400000);
    bru.setVar("offerId", body.offer.id);
    bru.setVar("slotA", first);
    bru.setVar("slotB", nextDay);
  }
}

tests {
  const v = (name) => bru.getVar(name) ?? bru.getEnvVar(name);
  test("200 with free times on more than one day", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().slots.length).to.be.above(1);
    expect(v("slotB")).to.be.a("string");
  });
}
