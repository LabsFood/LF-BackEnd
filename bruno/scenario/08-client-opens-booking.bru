meta {
  name: Client opens the booking
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/me/bookings/{{bookingId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

tests {
  test("200, no proposal, no commission", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().reschedule).to.equal(null);
    expect(res.getBody()).to.not.have.property("netCents");
  });
}
