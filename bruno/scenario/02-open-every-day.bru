meta {
  name: Open every day, 8:00 to 20:00
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/chef/availability
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "weekly": [
      {
        "weekday": 0,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 1,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 2,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 3,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 4,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 5,
        "startMinute": 480,
        "endMinute": 1200
      },
      {
        "weekday": 6,
        "startMinute": 480,
        "endMinute": 1200
      }
    ],
    "exceptions": [],
    "version": "{{scheduleVersion}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("scheduleVersion", res.getBody().version);
}

tests {
  test("200, seven ranges with new ids", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().weekly).to.have.length(7);
    expect(res.getBody().weekly[0].id).to.be.a("string");
  });
}
