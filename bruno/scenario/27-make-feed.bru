meta {
  name: Make the calendar feed link
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/chef/calendar-feed
  body: none
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("feedUrl", res.getBody().url);
}

tests {
  test("201 with the link, shown once", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().url).to.match(/\/calendar\/feed\/.+\.ics$/);
    expect(res.getBody().webcalUrl).to.match(/^webcal:/);
  });
}
