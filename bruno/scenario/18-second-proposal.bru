meta {
  name: One open proposal at a time
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/chef/bookings/{{bookingId}}/reschedule
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

body:json {
  {
    "startsAt": "{{slotB}}"
  }
}

tests {
  test("409", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("RESCHEDULE_PENDING");
  });
}
