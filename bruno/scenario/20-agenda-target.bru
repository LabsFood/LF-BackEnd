meta {
  name: Agenda draws the proposed time
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/chef/agenda?from={{in4Days}}&to={{in25Days}}
  body: none
  auth: bearer
}

params:query {
  from: {{in4Days}}
  to: {{in25Days}}
}

auth:bearer {
  token: {{chefToken}}
}

tests {
  const v = (name) => bru.getVar(name) ?? bru.getEnvVar(name);
  test("rescheduleTo is the proposed start", function () {
    expect(res.getStatus()).to.equal(200);
    const booking = res.getBody().prestations.find((p) => p.id === v("bookingId"));
    expect(new Date(booking.rescheduleTo).getTime()).to.equal(new Date(v("slotB")).getTime());
  });
}
