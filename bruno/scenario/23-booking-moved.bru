meta {
  name: The booking moved
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/me/bookings/{{bookingId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

tests {
  const v = (name) => bru.getVar(name) ?? bru.getEnvVar(name);
  test("starts at the new time, nothing pending", function () {
    expect(res.getStatus()).to.equal(200);
    expect(new Date(res.getBody().startsAt).getTime()).to.equal(new Date(v("slotB")).getTime());
    expect(res.getBody().reschedule).to.equal(null);
  });
}
