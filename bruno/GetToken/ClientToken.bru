meta {
  name: Client Token
  type: http
  seq: 4
}

post {
  url: https://api.clerk.com/v1/sessions/{{clientSessionId}}/tokens
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{clerkSecretKey}}
}

body:json {
  {
    "expires_in_seconds": 3600
  }
}

script:post-response {
  if (res.body?.jwt) {
    bru.setVar("clerkToken", res.body.jwt);
  }
}
