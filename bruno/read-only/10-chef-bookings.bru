meta {
  name: Batch cooker: my prestations
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/chef/bookings?limit=5
  body: none
  auth: bearer
}

params:query {
  limit: 5
}

auth:bearer {
  token: {{chefToken}}
}

tests {
  test("a page of prestations with city and earnings", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.data).to.be.an("array");
    expect(body.meta).to.be.an("object");
    for (const b of body.data) expect(b).to.include.all.keys("city", "netCents", "commissionCents");
  });
}
