meta {
  name: Public: free times with the default offer
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/chefs/{{chefProfileId}}/availability?from={{in1Day}}&to={{weekTo}}
  body: none
  auth: none
}

params:query {
  from: {{in1Day}}
  to: {{weekTo}}
}

vars:pre-request {
  in1Day: 1
  weekTo: 10
}

tests {
  test("200 naming the offer used", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.offer).to.include.all.keys("id", "name", "durationMinutes", "priceCents");
    expect(body.durationMinutes).to.equal(body.offer.durationMinutes);
    expect(body.slots).to.be.an("array");
    expect(body.scheduled).to.be.a("boolean");
  });
}
