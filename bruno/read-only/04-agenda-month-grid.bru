meta {
  name: Agenda, the month grid (42 days)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/chef/agenda?from={{weekFrom}}&to={{gridTo}}
  body: none
  auth: bearer
}

params:query {
  from: {{weekFrom}}
  to: {{gridTo}}
}

auth:bearer {
  token: {{chefToken}}
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
