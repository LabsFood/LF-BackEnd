meta {
  name: Public: an unknown calendar feed
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/calendar/feed/not-a-real-token.ics
  body: none
  auth: none
}

tests {
  test("404 FEED_NOT_FOUND", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().code).to.equal("FEED_NOT_FOUND");
    expect(res.getBody().requestId).to.be.a("string");
  });
}
