meta {
  name: A booking id that is not a uuid is a 400
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/me/bookings/not-a-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

tests {
  test("400 with a request id", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().requestId).to.be.a("string");
  });
}
