meta {
  name: Calendar feed status, never the link
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/chef/calendar-feed
  body: none
  auth: bearer
}

auth:bearer {
  token: {{chefToken}}
}

tests {
  test("200, enabled and synced, no url", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.enabled).to.be.a("boolean");
    expect(body.synced).to.be.a("boolean");
    expect(body).to.not.have.property("url");
  });
}
