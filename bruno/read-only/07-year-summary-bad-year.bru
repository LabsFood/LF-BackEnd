meta {
  name: Year view, a year out of range is a 400
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/chef/agenda/summary?year=1999
  body: none
  auth: bearer
}

params:query {
  year: 1999
}

auth:bearer {
  token: {{chefToken}}
}

tests {
  test("400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
