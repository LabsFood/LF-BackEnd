meta {
  name: Public: the week's cooks
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/menus/week
  body: none
  auth: none
}

tests {
  test("cards carry slotsLeft: null (on request) or at least one", function () {
    expect(res.getStatus()).to.equal(200);
    for (const card of res.getBody().data) {
      expect(card).to.have.property("slotsLeft");
      if (card.slotsLeft !== null) expect(card.slotsLeft).to.be.above(0);
    }
  });
}
