meta {
  name: Update my client profile (onboarding form 2)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/me/profile
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{clerkToken}}
}

body:json {
  {
    "firstName": "Marie",
    "lastName": "Dupont",
    "phone": "+33612345678",
    "dietaryPreferences": ["vegetarian"],
    "allergies": ["peanuts"],
    "addressStreet": "12 rue de la Paix",
    "addressCity": "Paris",
    "addressPostalCode": "75002",
    "householdAdults": 2,
    "householdKids": 1
  }
}
