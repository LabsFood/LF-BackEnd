meta {
  name: Create/update my chef profile (onboarding form 2)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/me/chef-profile
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{clerkToken}}
}

body:json {
  {
    "displayName": "Chef Marie D.",
    "bio": "Fifteen years of Mediterranean batch cooking.",
    "city": "Paris",
    "serviceRadiusKm": 25,
    "firstName": "Marie",
    "lastName": "Dupont",
    "phone": "+33612345678"
  }
}
